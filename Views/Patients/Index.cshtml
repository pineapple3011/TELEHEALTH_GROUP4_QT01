@model PatientProfileVm
@{
    ViewData["Title"] = "Hồ sơ của tôi";
    var words = Model.FullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = words.Length == 0 ? "BN"
        : string.Concat(words.Skip(Math.Max(0, words.Length - 2)).Select(w => char.ToUpperInvariant(w[0])));
}

<style>
    .pt-card { border: 1px solid #e3e6ea; border-radius: 12px; background: #fff; }
    .pt-avatar { width: 96px; height: 96px; border-radius: 50%; margin: 0 auto 14px; display: flex; align-items: center;
                 justify-content: center; color: #fff; font-size: 2rem; font-weight: 700;
                 background: linear-gradient(135deg,#6fc66b,#2c9d8f); }
    .pt-row { font-size: 14px; padding: 8px 0; border-bottom: 1px dashed #e3e6ea; }
    .pt-row:last-child { border-bottom: 0; }
    .pt-row span { display: block; color: #6c757d; font-size: 12px; }
    .pt-stat { text-align: center; padding: 18px 8px; }
    .pt-stat b { display: block; font-size: 28px; line-height: 1.1; }
    .pt-stat small { color: #6c757d; }
    .pt-badge { font-size: 12px; padding: 2px 10px; border-radius: 20px; background: #eceff2; color: #495057; white-space: nowrap; }
    .pt-badge.ok { background: #e6f6e8; color: #25803a; }
    .pt-badge.wait { background: #fff4db; color: #8a6200; }
    .pt-badge.bad { background: #fde8e8; color: #a12a2a; }
</style>

@functions {
    static string BadgeClass(string st) => st switch
    {
        "Đã xác nhận" or "Hoàn thành" => "ok",
        "Chờ xác nhận" => "wait",
        "Đã hủy" => "bad",
        _ => ""
    };
}

<div class="container my-5" style="min-height:60vh">
    <h2 class="mb-4">Hồ sơ của tôi</h2>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-success">@TempData["Msg"]</div>
    }

    @if (Model.PendingPayment > 0 && Model.PendingPayAppointId != null)
    {
        <div class="alert alert-warning d-flex flex-wrap align-items-center justify-content-between">
            <span>Bạn có <b>@Model.PendingPayment</b> lịch khám đang chờ thanh toán.</span>
            <a asp-controller="Appointments" asp-action="Pay" asp-route-id="@Model.PendingPayAppointId"
               class="btn btn-warning btn-sm">Thanh toán ngay</a>
        </div>
    }

    <div class="row">
        <!-- Thông tin cá nhân -->
        <div class="col-lg-4 mb-4">
            <div class="pt-card p-4">
                <div class="pt-avatar">@initials</div>
                <h5 class="text-center mb-3">@Model.FullName</h5>

                <div class="pt-row"><span>Email</span>@Model.Email</div>
                <div class="pt-row"><span>Số điện thoại</span>@Model.Phone</div>
                <div class="pt-row"><span>Địa chỉ</span>@(string.IsNullOrWhiteSpace(Model.Address) ? "Chưa cập nhật" : Model.Address)</div>
                <div class="pt-row"><span>SĐT người thân (khi khẩn cấp)</span>@(string.IsNullOrWhiteSpace(Model.EmergencyPhone) ? "Chưa cập nhật" : Model.EmergencyPhone)</div>

                <a asp-action="Edit" class="btn btn-success btn-block mt-3">Chỉnh sửa thông tin</a>
            </div>
        </div>

        <div class="col-lg-8">
            <!-- Thống kê -->
            <div class="row mb-4">
                <div class="col-6 col-md-3 mb-3"><div class="pt-card pt-stat"><b>@Model.Total</b><small>Tổng ca khám</small></div></div>
                <div class="col-6 col-md-3 mb-3"><div class="pt-card pt-stat"><b>@Model.Upcoming</b><small>Sắp tới</small></div></div>
                <div class="col-6 col-md-3 mb-3"><div class="pt-card pt-stat"><b>@Model.Completed</b><small>Đã hoàn thành</small></div></div>
                <div class="col-6 col-md-3 mb-3"><div class="pt-card pt-stat"><b>@Model.PendingPayment</b><small>Chờ thanh toán</small></div></div>
            </div>

            <!-- Lịch sắp tới -->
            <div class="pt-card p-4 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Lịch khám sắp tới</h5>
                    <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-success btn-sm">+ Đặt lịch mới</a>
                </div>
                @if (!Model.UpcomingList.Any())
                {
                    <p class="text-muted mb-0">Bạn chưa có lịch khám sắp tới.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Ngày</th><th>Giờ</th><th>Bác sĩ</th><th>Hình thức</th><th>Trạng thái</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var r in Model.UpcomingList)
                            {
                                <tr>
                                    <td>@r.DateText</td>
                                    <td>@r.TimeText</td>
                                    <td>@r.DoctorName</td>
                                    <td>@r.HinhThuc</td>
                                    <td><span class="pt-badge @BadgeClass(r.TrangThai)">@r.TrangThai</span></td>
                                    <td><a asp-controller="Appointments" asp-action="Details" asp-route-id="@r.AppointId">Chi tiết</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- Lịch sử gần đây -->
            <div class="pt-card p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Lịch sử khám gần đây</h5>
                    <a asp-controller="Appointments" asp-action="Index">Xem tất cả</a>
                </div>
                @if (!Model.RecentList.Any())
                {
                    <p class="text-muted mb-0">Chưa có lịch sử khám.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm mb-0">
                            <thead><tr><th>Ngày</th><th>Giờ</th><th>Bác sĩ</th><th>Hình thức</th><th>Trạng thái</th><th></th></tr></thead>
                            <tbody>
                            @foreach (var r in Model.RecentList)
                            {
                                <tr>
                                    <td>@r.DateText</td>
                                    <td>@r.TimeText</td>
                                    <td>@r.DoctorName</td>
                                    <td>@r.HinhThuc</td>
                                    <td><span class="pt-badge @BadgeClass(r.TrangThai)">@r.TrangThai</span></td>
                                    <td><a asp-controller="Appointments" asp-action="Details" asp-route-id="@r.AppointId">Chi tiết / đơn thuốc</a></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
