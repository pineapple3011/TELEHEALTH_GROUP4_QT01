@model TELEHEALTH_GROUP4_QT01.Models.ViewModels.DoctorDetailsVm
@using System.Text.Json
@{
    ViewData["Title"] = $"Bác sĩ {Model.HoTen} - Lịch làm việc";

    // Gom ca theo ngày để vẽ calendar
    var calData = Model.Days
        .GroupBy(d => d.DateIso)
        .Select(g => new
        {
            date = g.Key,
            shifts = g.Select(s => new
            {
                scheduleId = s.ScheduleId,
                range = s.RangeText,
                shift = (s.RangeText.Contains("Chiều") || s.RangeText.StartsWith("13") || s.RangeText.StartsWith("14")) ? "Ca Chiều" :
                        (s.RangeText.Contains("Tối") || s.RangeText.StartsWith("17") || s.RangeText.StartsWith("18")) ? "Ca Tối" : "Ca Sáng",
                slots = s.FreeSlots
            }).ToList()
        })
        .ToList();
    var calJson = JsonSerializer.Serialize(calData);
    var createUrl = JsonSerializer.Serialize(Url.Action("Create", "Appointments") ?? "/Appointments/Create");
}

<style>
    /* ===== Bảng màu xanh blue (nhạt -> đậm), đồng bộ với trang quản trị ===== */
    .dd-page {
        --dd-navy: #0f2557;
        --dd-ink: #12264d;
        --dd-blue: #1b63d6;
        --dd-blue-dark: #1553b8;
        --dd-sky: #e3edfa;
        --dd-mist: #f4f8fe;
        --dd-line: #dbe5f3;
        --dd-muted: #5f6f89;
        color: var(--dd-ink);
        font-size: 15px;
    }

    .dd-back { display: inline-block; margin-bottom: 14px; font-weight: 600; color: var(--dd-blue); text-decoration: none; }
    .dd-back:hover { color: var(--dd-navy); text-decoration: underline; }

    /* ===== Banner đầu trang ===== */
    .dd-hero {
        display: flex; align-items: center; gap: 24px;
        padding: 28px 32px; margin-bottom: 22px; color: #fff; border-radius: 16px;
        background-color: var(--dd-navy);
        background-image: radial-gradient(rgba(255,255,255,.10) 1px, transparent 1px),
                          linear-gradient(100deg, #0f2557 0%, #1a4290 55%, #2f78dc 100%);
        background-size: 16px 16px, 100% 100%;
        box-shadow: 0 10px 28px rgba(15,37,87,.18);
    }
    .dd-hero-avatar { width: 104px; height: 120px; border-radius: 16px; object-fit: cover; flex-shrink: 0; border: 3px solid rgba(255,255,255,.35); background: #1b4fa8; }
    .dd-hero-ph { display: flex; align-items: center; justify-content: center; font-size: 38px; font-weight: 700; color: #fff; }
    .dd-eyebrow { display: inline-block; padding: 3px 12px; margin-bottom: 8px; border-radius: 999px; background: rgba(255,255,255,.16); font-size: 12px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase; }
    .dd-hero h1 { margin: 0 0 6px; color: #fff; font-size: 30px; font-weight: 800; line-height: 1.25; }
    .dd-hero p { margin: 0; color: rgba(255,255,255,.9); font-size: 16px; }
    .dd-hero p b { color: #fff; }

    /* ===== Khối nội dung: tiêu đề xanh nhạt, vạch xanh bên trái ===== */
    .dd-card { background: #fff; border: 1px solid var(--dd-line); border-radius: 14px; overflow: hidden; box-shadow: 0 4px 16px rgba(15,37,87,.04); }
    .dd-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 14px 22px; background: var(--dd-sky); border-bottom: 1px solid var(--dd-line); }
    .dd-head h2 { margin: 0; padding-left: 12px; border-left: 4px solid var(--dd-blue); font-size: 14.5px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: var(--dd-ink); line-height: 1.3; }
    .dd-body { padding: 22px; }

    .dd-kv { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid #e9eff8; }
    .dd-kv:first-child { padding-top: 0; }
    .dd-kv:last-child { border-bottom: 0; }
    .dd-kv .k { color: var(--dd-muted); flex-shrink: 0; }
    .dd-kv .v { font-weight: 700; color: var(--dd-ink); text-align: right; }
    .dd-kv .v.fee { color: var(--dd-blue); font-size: 17px; }

    .dd-sub { margin: 20px 0 10px; padding-left: 10px; border-left: 3px solid var(--dd-blue); font-size: 13px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; }
    .dd-bio { padding: 14px 16px; border-radius: 10px; background: var(--dd-mist); color: #3d4d68; line-height: 1.65; font-size: 14.5px; }
    .dd-hint { margin: 0 0 18px; color: var(--dd-muted); font-size: 14px; }

    /* ===== Lịch chọn ngày ===== */
    .cal-wrap { border: 1px solid var(--dd-line); border-radius: 14px; padding: 16px; background: #fff; }
    .cal-head { display: flex; align-items: center; justify-content: space-between; padding-bottom: 12px; margin-bottom: 10px; border-bottom: 1px solid #e9eff8; font-weight: 700; font-size: 16px; color: var(--dd-ink); }
    .cal-nav { display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; padding: 0; border: 0; border-radius: 50%; background: var(--dd-sky); color: var(--dd-blue); font-size: 22px; line-height: 1; cursor: pointer; transition: background .2s, color .2s; }
    .cal-nav:hover:not(:disabled) { background: var(--dd-blue); color: #fff; }
    .cal-nav:disabled { color: #b4c3dc; cursor: default; }
    .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; text-align: center; }
    .cal-dow { padding: 6px 0; margin-bottom: 4px; border-bottom: 1px solid #e9eff8; font-size: 12.5px; font-weight: 700; color: var(--dd-muted); }
    .cal-cell { position: relative; height: 48px; padding: 0; border: 2px solid transparent; border-radius: 10px; background: transparent; font-size: 15px; transition: all .15s; }
    .cal-empty { visibility: hidden; }
    .cal-off, .cal-full { color: #b4c0d4; cursor: not-allowed; }
    .cal-full { text-decoration: line-through; }
    .cal-on { background: var(--dd-mist); color: var(--dd-ink); font-weight: 700; cursor: pointer; }
    .cal-on:hover { background: var(--dd-sky); border-color: var(--dd-blue); }
    .cal-on i { position: absolute; left: 50%; bottom: 5px; width: 6px; height: 6px; margin-left: -3px; border-radius: 50%; background: var(--dd-blue); }
    .cal-today { box-shadow: inset 0 0 0 1px var(--dd-blue); }
    .cal-sel, .cal-sel:hover { border-color: var(--dd-blue); background: var(--dd-blue); color: #fff !important; }
    .cal-sel i { background: #fff !important; }
    .cal-legend { display: flex; justify-content: space-between; align-items: center; margin-top: 14px; padding-top: 10px; border-top: 1px solid #e9eff8; font-size: 13px; color: var(--dd-muted); }
    .cal-legend .dot { display: inline-block; width: 8px; height: 8px; margin-right: 6px; border-radius: 50%; }

    /* ===== Khung giờ ===== */
    .dd-slots-panel { height: 100%; display: flex; flex-direction: column; padding: 18px; border: 1px solid var(--dd-line); border-radius: 14px; background: var(--dd-mist); }
    .dd-slots-panel h3 { margin: 0 0 4px; font-size: 16px; font-weight: 700; color: var(--dd-ink); }
    .dd-slots-panel .desc { margin: 0 0 14px; font-size: 13.5px; color: var(--dd-muted); }
    .slot-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 10px; }
    .slot-btn { display: block; padding: 9px 4px; border: 1px solid #c3d6f3; border-radius: 8px; background: #fff; color: var(--dd-blue-dark); font-size: 14px; font-weight: 700; text-align: center; text-decoration: none !important; transition: all .2s; }
    .slot-btn:hover { background: var(--dd-blue); border-color: var(--dd-blue); color: #fff; }
    .slot-btn.selected { background: var(--dd-navy); border-color: var(--dd-navy); color: #fff; box-shadow: 0 4px 10px rgba(15,37,87,.25); }
    .shift-pill { display: inline-block; margin: 0 6px 6px 0; padding: 5px 14px; border: 1px solid #c3d6f3; border-radius: 999px; background: #fff; color: #3d4d68; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .15s; }
    .shift-pill:hover { border-color: var(--dd-blue); color: var(--dd-blue); }
    .shift-pill.active { background: var(--dd-blue); border-color: var(--dd-blue); color: #fff; }
    .dd-shift-title { margin: 10px 0 8px; font-size: 13px; font-weight: 700; color: var(--dd-muted); }

    .dd-confirm { margin-top: 14px; padding: 14px; border: 1px solid var(--dd-blue); border-radius: 10px; background: #fff; text-align: center; }
    .dd-confirm .lbl { margin-bottom: 2px; font-size: 13px; color: var(--dd-muted); }
    .dd-confirm .time { margin: 0 0 10px; font-size: 20px; font-weight: 800; color: var(--dd-blue-dark); }
    .dd-btn { display: block; padding: 11px 14px; border-radius: 8px; background: var(--dd-blue); color: #fff !important; font-size: 15px; font-weight: 700; text-align: center; text-decoration: none !important; box-shadow: 0 4px 12px rgba(27,99,214,.25); transition: background .2s; }
    .dd-btn:hover { background: var(--dd-blue-dark); }
    .dd-btn-outline { display: inline-block; padding: 8px 20px; border: 1px solid var(--dd-blue); border-radius: 8px; background: #fff; color: var(--dd-blue) !important; font-weight: 600; text-decoration: none !important; }
    .dd-btn-outline:hover { background: var(--dd-sky); }
    .dd-empty { padding: 28px 20px; border: 1px dashed #b7cbec; border-radius: 12px; background: var(--dd-mist); text-align: center; color: var(--dd-muted); }
    .dd-empty h3 { margin: 0 0 6px; font-size: 17px; font-weight: 700; color: var(--dd-ink); }

    @@media (max-width: 767px) {
        .dd-hero { flex-direction: column; align-items: flex-start; padding: 22px 20px; }
        .dd-hero h1 { font-size: 24px; }
    }
</style>

<div class="container my-4 dd-page" style="min-height: 65vh;">
    <a asp-action="Index" class="dd-back">&larr; Quay lại danh sách bác sĩ</a>

    <!-- Banner bác sĩ -->
    <div class="dd-hero">
        @if (!string.IsNullOrEmpty(Model.AvatarUrl))
        {
            <img src="@Url.Content(Model.AvatarUrl)" alt="@Model.HoTen" class="dd-hero-avatar" />
        }
        else
        {
            <div class="dd-hero-avatar dd-hero-ph">BS</div>
        }
        <div>
            <span class="dd-eyebrow">Hồ sơ bác sĩ</span>
            <h1>@Model.HoTen</h1>
            <p>Chuyên khoa: <b>@Model.TenKhoa</b></p>
        </div>
    </div>

    <div class="row">
        <!-- CỘT TRÁI: THÔNG TIN BÁC SĨ -->
        <div class="col-lg-4 mb-4">
            <div class="dd-card h-100">
                <div class="dd-head"><h2>Thông tin bác sĩ</h2></div>
                <div class="dd-body">
                    <div class="dd-kv"><span class="k">Chuyên khoa</span><span class="v">@Model.TenKhoa</span></div>
                    <div class="dd-kv"><span class="k">Kinh nghiệm</span><span class="v">@Cv.Years(Model.KinhNghiem)</span></div>
                    <div class="dd-kv"><span class="k">Phí khám cơ bản</span><span class="v fee">@Cv.Money(Model.Fee)</span></div>

                    @if (!string.IsNullOrWhiteSpace(Model.MoTa))
                    {
                        <div class="dd-sub">Giới thiệu</div>
                        <div class="dd-bio">@Model.MoTa</div>
                    }
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: CHỌN NGÀY VÀ KHUNG GIỜ KHÁM -->
        <div class="col-lg-8 mb-4">
            <div class="dd-card h-100">
                <div class="dd-head"><h2>Chọn lịch làm việc &amp; đặt giờ</h2></div>
                <div class="dd-body">
                    <p class="dd-hint">Chọn ngày trên lịch, sau đó bấm vào khung giờ trống bạn muốn khám.</p>

                    @if (!Model.Days.Any())
                    {
                        <div class="dd-empty">
                            <h3>Bác sĩ chưa có lịch làm việc trong những ngày tới</h3>
                            <p class="mb-3">Vui lòng quay lại sau hoặc xem các bác sĩ khác cùng chuyên khoa.</p>
                            <a asp-action="Index" class="dd-btn-outline">Xem bác sĩ khác</a>
                        </div>
                    }
                    else
                    {
                        <div class="row">
                            <!-- Lịch tháng chọn ngày -->
                            <div class="col-md-7 mb-4 mb-md-0">
                                <div class="cal-wrap" id="cal">
                                    <div class="cal-head">
                                        <button type="button" class="cal-nav" id="calPrev" aria-label="Tháng trước">&#8249;</button>
                                        <span id="calTitle"></span>
                                        <button type="button" class="cal-nav" id="calNext" aria-label="Tháng sau">&#8250;</button>
                                    </div>
                                    <div class="cal-grid" id="calDow">
                                        <div class="cal-dow">T2</div><div class="cal-dow">T3</div><div class="cal-dow">T4</div>
                                        <div class="cal-dow">T5</div><div class="cal-dow">T6</div><div class="cal-dow">T7</div>
                                        <div class="cal-dow">CN</div>
                                    </div>
                                    <div class="cal-grid" id="calGrid"></div>
                                    <div class="cal-legend">
                                        <span><span class="dot" style="background:#1b63d6;"></span>Có lịch trống</span>
                                        <span><span class="dot" style="background:#d3dbe8;"></span>Hết chỗ / Nghỉ</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Khung giờ khám của ngày đã chọn -->
                            <div class="col-md-5">
                                <div class="dd-slots-panel">
                                    <h3 id="selectedDateTitle">Khung giờ ngày:</h3>
                                    <p class="desc" id="selectedDateDesc">Chọn 1 ngày để xem giờ trống</p>

                                    <!-- Bộ lọc ca làm việc -->
                                    <div class="mb-2" id="shiftFilterGroup">
                                        <span class="shift-pill active" onclick="filterShift('all', this)">Tất cả</span>
                                        <span class="shift-pill" onclick="filterShift('morning', this)">Sáng</span>
                                        <span class="shift-pill" onclick="filterShift('afternoon', this)">Chiều</span>
                                        <span class="shift-pill" onclick="filterShift('evening', this)">Tối</span>
                                    </div>

                                    <!-- Danh sách khung giờ -->
                                    <div id="slotsContainer" class="flex-grow-1" style="max-height: 250px; overflow-y: auto;"></div>

                                    <!-- Xác nhận giờ đã chọn -->
                                    <div id="confirmBookingBox" class="dd-confirm" style="display: none;">
                                        <div class="lbl">Khung giờ bạn đang chọn:</div>
                                        <h5 class="time" id="selectedSlotText">09:30</h5>
                                        <a href="#" id="btnBookSlot" class="dd-btn">Tiến hành đặt lịch khám &rarr;</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var calData = @Html.Raw(calJson);
        var createUrlBase = @Html.Raw(createUrl);
        var currentYear, currentMonth;
        var selectedIso = null;
        var selectedScheduleId = null;
        var selectedSlotTime = null;
        var activeShiftFilter = 'all';

        // Lấy ngày đầu tiên có lịch làm việc
        if (calData && calData.length > 0) {
            var firstDate = new Date(calData[0].date);
            currentYear = firstDate.getFullYear();
            currentMonth = firstDate.getMonth();
        } else {
            var now = new Date();
            currentYear = now.getFullYear();
            currentMonth = now.getMonth();
        }

        function renderCalendar() {
            var titleEl = document.getElementById('calTitle');
            var gridEl = document.getElementById('calGrid');
            if (!gridEl) return;

            gridEl.innerHTML = '';
            var monthNames = ["Tháng 1", "Tháng 2", "Tháng 3", "Tháng 4", "Tháng 5", "Tháng 6",
                "Tháng 7", "Tháng 8", "Tháng 9", "Tháng 10", "Tháng 11", "Tháng 12"];
            titleEl.innerText = monthNames[currentMonth] + " / " + currentYear;

            var firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
            // Điều chỉnh để Thứ Hai là cột đầu tiên
            var pad = (firstDayIndex + 6) % 7;
            for (var i = 0; i < pad; i++) {
                var empty = document.createElement('div');
                empty.className = 'cal-cell cal-empty';
                gridEl.appendChild(empty);
            }

            var daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
            var todayStr = new Date().toISOString().split('T')[0];

            for (var d = 1; d <= daysInMonth; d++) {
                var mm = String(currentMonth + 1).padStart(2, '0');
                var dd = String(d).padStart(2, '0');
                var iso = currentYear + '-' + mm + '-' + dd;

                var cell = document.createElement('button');
                cell.type = 'button';
                cell.className = 'cal-cell';
                cell.innerText = d;

                if (iso === todayStr) cell.classList.add('cal-today');

                var dayMatch = calData.find(x => x.date === iso);
                if (dayMatch && dayMatch.shifts.some(s => s.slots && s.slots.length > 0)) {
                    cell.classList.add('cal-on');
                    var dot = document.createElement('i');
                    cell.appendChild(dot);
                    cell.onclick = (function(matchIso) {
                        return function() { selectDate(matchIso); };
                    })(iso);
                } else {
                    cell.classList.add('cal-off');
                    cell.disabled = true;
                }

                if (selectedIso === iso) {
                    cell.classList.add('cal-sel');
                }

                gridEl.appendChild(cell);
            }
        }

        function selectDate(iso) {
            selectedIso = iso;
            renderCalendar();

            var dayMatch = calData.find(x => x.date === iso);
            if (!dayMatch) return;

            var dateObj = new Date(iso);
            var titleStr = "Ngày " + dateObj.toLocaleDateString('vi-VN', { weekday: 'long', day: '2-digit', month: '2-digit', year: 'numeric' });
            document.getElementById('selectedDateTitle').innerText = titleStr;
            document.getElementById('selectedDateDesc').innerText = "Chọn một khung giờ phù hợp dưới đây:";

            renderSlots(dayMatch);
        }

        function renderSlots(dayMatch) {
            var container = document.getElementById('slotsContainer');
            container.innerHTML = '';
            document.getElementById('confirmBookingBox').style.display = 'none';

            var totalSlotsCount = 0;

            dayMatch.shifts.forEach(function(shift) {
                var filteredSlots = shift.slots;
                if (activeShiftFilter === 'morning') {
                    filteredSlots = shift.slots.filter(s => parseInt(s.split(':')[0]) < 12);
                } else if (activeShiftFilter === 'afternoon') {
                    filteredSlots = shift.slots.filter(s => parseInt(s.split(':')[0]) >= 12 && parseInt(s.split(':')[0]) < 18);
                } else if (activeShiftFilter === 'evening') {
                    filteredSlots = shift.slots.filter(s => parseInt(s.split(':')[0]) >= 18);
                }

                if (filteredSlots.length > 0) {
                    var shiftHeader = document.createElement('div');
                    shiftHeader.className = 'dd-shift-title';
                    shiftHeader.innerText = (shift.shift || 'Ca khám') + ' (' + shift.range + '):';
                    container.appendChild(shiftHeader);

                    var grid = document.createElement('div');
                    grid.className = 'slot-grid mb-3';

                    filteredSlots.forEach(function(slot) {
                        totalSlotsCount++;
                        var btn = document.createElement('a');
                        btn.href = '#';
                        btn.className = 'slot-btn';
                        btn.innerText = slot;
                        btn.onclick = function(e) {
                            e.preventDefault();
                            $('.slot-btn').removeClass('selected');
                            $(this).addClass('selected');
                            chooseSlot(shift.scheduleId, slot);
                        };
                        grid.appendChild(btn);
                    });
                    container.appendChild(grid);
                }
            });

            if (totalSlotsCount === 0) {
                container.innerHTML = '<div class="dd-empty my-3">Không có khung giờ nào trống trong ca này. Vui lòng chọn ca hoặc ngày khác.</div>';
            }
        }

        function filterShift(shiftType, el) {
            $('.shift-pill').removeClass('active');
            $(el).addClass('active');
            activeShiftFilter = shiftType;
            if (selectedIso) {
                var dayMatch = calData.find(x => x.date === selectedIso);
                if (dayMatch) renderSlots(dayMatch);
            }
        }

        function chooseSlot(scheduleId, slotTime) {
            selectedScheduleId = scheduleId;
            selectedSlotTime = slotTime;

            var box = document.getElementById('confirmBookingBox');
            box.style.display = 'block';
            document.getElementById('selectedSlotText').innerText = slotTime + ' - ' + selectedIso;

            var bookBtn = document.getElementById('btnBookSlot');
            bookBtn.href = createUrlBase + '?doctorId=@Model.DoctorId&scheduleId=' + scheduleId + '&time=' + encodeURIComponent(slotTime);
        }

        $('#calPrev').click(function() {
            currentMonth--;
            if (currentMonth < 0) { currentMonth = 11; currentYear--; }
            renderCalendar();
        });

        $('#calNext').click(function() {
            currentMonth++;
            if (currentMonth > 11) { currentMonth = 0; currentYear++; }
            renderCalendar();
        });

        // Tự động chọn ngày đầu tiên có lịch
        if (calData && calData.length > 0) {
            selectDate(calData[0].date);
        } else {
            renderCalendar();
        }
    </script>
}
