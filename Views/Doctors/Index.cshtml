@model TELEHEALTH_GROUP4_QT01.Models.ViewModels.DoctorListVm
@{
    ViewData["Title"] = "Tìm bác sĩ chuyên khoa";

    var sorts = new[]
    {
        (Key: "",        Text: "Mặc định (ưu tiên bác sĩ sẵn sàng)"),
        (Key: "exp",     Text: "Kinh nghiệm nhiều nhất"),
        (Key: "feeAsc",  Text: "Phí khám thấp → cao"),
        (Key: "feeDesc", Text: "Phí khám cao → thấp"),
        (Key: "name",    Text: "Tên bác sĩ A → Z")
    };

    var activeSpec = Model.SpecCards.FirstOrDefault(s => s.SpecId == Model.SpecId);
    bool hasFilter = !string.IsNullOrWhiteSpace(Model.Q) || Model.SpecId != null
                     || Model.OnlyAvailable || !string.IsNullOrEmpty(Model.Sort);
}

<style>
    /* Sidebar Filter Widget */
    .dl-side .dl-widget {
        margin-bottom: 28px;
        background: #fff;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #e9ecef;
        box-shadow: 0 2px 8px rgba(0,0,0,0.02);
    }

    .dl-side .dl-title {
        font-size: 16px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 14px;
        padding-bottom: 8px;
        border-bottom: 2px solid #0056b3;
        color: #1a2f23;
        display: block;
    }

    .dl-search {
        position: relative;
    }

        .dl-search input {
            padding-right: 44px;
            border-radius: 20px;
        }

        .dl-search button {
            position: absolute;
            right: 4px;
            top: 3px;
            width: 32px;
            height: 32px;
            border: 0;
            border-radius: 50%;
            background: #0056b3;
            color: #fff;
            transition: background .2s;
        }

            .dl-search button:hover {
                background: #0056b3;
            }

    /* Doctor Card */
    .doc-card-enhanced {
        background: #fff;
        border-radius: 14px;
        border: 1px solid #e9ecef;
        overflow: hidden;
        transition: box-shadow .25s, transform .25s;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .doc-card-enhanced:hover {
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            transform: translateY(-3px);
            border-color: #c8e6c9;
        }

    .doc-card-body {
        padding: 18px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .doc-badge-status {
        font-size: 11px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
        display: inline-block;
    }

        .doc-badge-status.on {
            background: #e8f5e9;
            color: #2c9d8f;
        }

        .doc-badge-status.off {
            background: #f1f3f5;
            color: #6c757d;
        }
</style>

<div class="container my-4" style="min-height: 65vh;">
    <div class="row">

        <!-- ========== SIDEBAR BỘ LỌC BÁC SĨ ========== -->
        <div class="col-12 col-md-4 col-lg-3 mb-4">
            <form method="get" asp-action="Index" id="doctorFilter" class="dl-side">

                <!-- 1. Ô Tìm Kiếm -->
                <div class="dl-widget">
                    <h5 class="dl-title"><i class="fa fa-search text-success mr-1"></i> Tìm Bác Sĩ</h5>
                    <div class="dl-search">
                        <input type="text" name="q" value="@Model.Q" class="form-control form-control-sm" placeholder="Nhập tên bác sĩ..." />
                        <button type="submit" aria-label="Tìm"><i class="fa fa-search"></i></button>
                    </div>
                </div>

                <!-- 2. Lọc Theo Chuyên Khoa -->
                <div class="dl-widget">
                    <h5 class="dl-title"><i class="fa fa-stethoscope text-success mr-1"></i> Chuyên Khoa</h5>
                    <div class="custom-control custom-radio mb-2">
                        <input type="radio" class="custom-control-input" id="spec-all" name="specId" value=""
                               onchange="this.form.submit()" checked="@(Model.SpecId == null)" />
                        <label class="custom-control-label" for="spec-all">Tất cả khoa <span class="text-muted small">(@Model.TotalAll)</span></label>
                    </div>
                    @foreach (var sp in Model.SpecCards)
                    {
                        <div class="custom-control custom-radio mb-2">
                            <input type="radio" class="custom-control-input" id="spec-@sp.SpecId" name="specId" value="@sp.SpecId"
                                   onchange="this.form.submit()" checked="@(Model.SpecId == sp.SpecId)" />
                            <label class="custom-control-label small" for="spec-@sp.SpecId">@sp.Name <span class="text-muted">(@sp.DoctorCount)</span></label>
                        </div>
                    }
                </div>

                <!-- 3. Trạng Thái Nhận Khám -->
                <div class="dl-widget">
                    <h5 class="dl-title"><i class="fa fa-clock-o text-success mr-1"></i> Trạng Thái</h5>
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="onlyAvailable" name="onlyAvailable" value="true"
                               onchange="this.form.submit()" checked="@Model.OnlyAvailable" />
                        <label class="custom-control-label small font-weight-bold" for="onlyAvailable">Chỉ bác sĩ đang nhận khám</label>
                    </div>
                </div>

                <!-- 4. Sắp Xếp Kết Quả -->
                <div class="dl-widget">
                    <h5 class="dl-title"><i class="fa fa-sort-amount-desc text-success mr-1"></i> Sắp Xếp</h5>
                    @for (int i = 0; i < sorts.Length; i++)
                    {
                        var s = sorts[i];
                        bool isOn = string.IsNullOrEmpty(Model.Sort) ? s.Key == "" : s.Key == Model.Sort;
                        <div class="custom-control custom-radio mb-2">
                            <input type="radio" class="custom-control-input" id="sort-@i" name="sort" value="@s.Key"
                                   onchange="this.form.submit()" checked="@isOn" />
                            <label class="custom-control-label small" for="sort-@i">@s.Text</label>
                        </div>
                    }
                </div>

                @if (hasFilter)
                {
                    <a asp-action="Index" class="btn btn-outline-danger btn-sm btn-block">
                        <i class="fa fa-refresh mr-1"></i> Xóa tất cả bộ lọc
                    </a>
                }
            </form>
        </div>

        <!-- ========== DANH SÁCH BÁC SĨ ========== -->
        <div class="col-12 col-md-8 col-lg-9">
            <!-- Topbar hiển thị kết quả -->
            <div class="d-flex flex-wrap align-items-center justify-content-between p-3 bg-white rounded-lg shadow-sm border mb-4">
                <div>
                    <h5 class="font-weight-bold text-dark mb-0">
                        Đội Ngũ Bác Sĩ Chuyên Khoa <span class="badge badge-success ml-2">@Model.Doctors.Count / @Model.TotalAll</span>
                    </h5>
                    @if (activeSpec != null)
                    {
                        <span class="badge badge-soft-success mt-1 mr-1">Khoa: @activeSpec.Name</span>
                    }
                    @if (Model.OnlyAvailable)
                    {
                        <span class="badge badge-soft-primary mt-1 mr-1">Đang nhận khám</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Q))
                    {
                        <span class="badge badge-soft-warning mt-1">Từ khóa: “@Model.Q”</span>
                    }
                </div>
            </div>

            @if (!Model.Doctors.Any())
            {
                <div class="card border-0 shadow-sm p-5 text-center my-4">
                    <div class="mb-3">
                        <i class="fa fa-user-times text-muted" style="font-size: 50px;"></i>
                    </div>
                    <h5 class="font-weight-bold text-dark">Không tìm thấy bác sĩ phù hợp</h5>
                    <p class="text-muted small mb-3">Hãy thử bỏ bớt bộ lọc hoặc tìm kiếm theo từ khóa chuyên khoa khác.</p>
                    <div>
                        <a asp-action="Index" class="btn btn-success px-4 py-2 font-weight-bold">
                            <i class="fa fa-refresh mr-1"></i> Đặt lại bộ lọc tìm kiếm
                        </a>
                    </div>
                </div>
            }

            <div class="row">
                @foreach (var d in Model.Doctors)
                {
                    var isAvail = Cv.IsAvailable(d.TrangThai);

                    <div class="col-sm-6 col-xl-4 mb-4">
                        <div class="doc-card-enhanced">
                            <div style="position: relative;">
                                <a asp-action="Details" asp-route-id="@d.DoctorId">
                                    @await Html.PartialAsync("_DoctorAvatar", new AvatarVm
                                    {
                                        Name = d.HoTen,
                                        Url = d.AvatarUrl,
                                        Width = "100%",
                                        Height = "240px",
                                        Radius = "0",
                                        FontSize = "3.2rem",
                                        Fit = "cover"
                                    })
                                </a>
                                <div style="position: absolute; top: 12px; right: 12px;">
                                    <span class="doc-badge-status @(isAvail ? "on" : "off") shadow-sm">
                                        <i class="fa fa-circle mr-1" style="font-size: 8px;"></i> @(isAvail ? "Nhận khám" : "Tạm bận")
                                    </span>
                                </div>
                            </div>

                            <div class="doc-card-body">
                                <h6 class="font-weight-bold mb-2">
                                    <a asp-action="Details" asp-route-id="@d.DoctorId" class="text-dark text-decoration-none">
                                        @d.HoTen
                                    </a>
                                </h6>

                                <div class="small text-muted mb-2">
                                    <div>Khoa: <b>@d.TenKhoa</b></div>
                                    <div>Kinh nghiệm: <b>@Cv.Years(d.KinhNghiem)</b></div>
                                </div>

                                <div class="mt-auto pt-2 border-top">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="small text-muted">Phí khám:</span>
                                        <span class="font-weight-bold text-success" style="font-size: 15px;">@Cv.Money(d.Fee)</span>
                                    </div>
                                    <div>
                                        <a asp-action="Details" asp-route-id="@d.DoctorId" class="btn btn-success btn-sm btn-block font-weight-bold py-2 shadow-sm">
                                            <i class="fa fa-calendar-check-o mr-1"></i> Xem lịch &amp; Đặt khám
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</div>
