@model TELEHEALTH_GROUP4_QT01.Models.ViewModels.AppointmentDetailsVm
@{
    ViewData["Title"] = $"Chi tiết lịch khám #TK-{Model.AppointId:D5}";
    var isOnline = Model.HinhThuc == "Online";
    var isEmergency = Model.HinhThuc == "Cấp cứu";
    var isCompleted = Model.TrangThai == "Hoàn thành";
    var isCancelled = Model.TrangThai == "Đã hủy";
    var canCancel = (Model.TrangThai == "Chờ xác nhận" || Model.TrangThai == "Đã xác nhận");
    var canJoinOnline = isOnline && !isCancelled;
    var receiptFile = Model.Files.FirstOrDefault(f => f.Loai != null && (f.Loai.Contains("Biên lai") || f.Loai.Contains("receipt")));

    var statusText = isCompleted ? "Đã khám xong" : Model.TrangThai;

    var dotColor = isCompleted ? "#7fe9d6" : "#ffffff";
    var statusCls = isCancelled ? "cancelled" : "";

    var nameParts = (Model.DoctorName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initial = nameParts.Length > 0 ? nameParts[nameParts.Length - 1].Substring(0, 1).ToUpper() : "B";
}

<style>
    :root {
        --ap-navy: #1d2b4f;
        --ap-bar: #2b4c7e;
        --ap-head: #dce8f7;        /* nền tiêu đề 4 khối (xanh nhạt) */
        --ap-head-text: #1d2b4f;   /* chữ tiêu đề 4 khối */
        --ap-blue: #0056b3;
        --ap-teal: #2c9d8f;
        --ap-line: #e6ecf2;
        --ap-muted: #6b7785;
        /* Nếu tiêu đề trang dùng font riêng, thay inherit bằng font đó, VD: "Be Vietnam Pro", sans-serif */
        --ap-font: inherit;
    }

    /* ===== Đồng bộ font (không đụng tới icon FontAwesome) ===== */
    .ap-font,
    .ap-font *:not(.fa):not(.fas):not(.far):not(i) {
        font-family: var(--ap-font);
    }

    /* ===== Banner gradient ===== */
    .dt-banner {
        background: linear-gradient(135deg, #2b4c7e, #1f6fc2);
        border-radius: 18px;
        padding: 28px 32px;
        color: #fff;
        margin-bottom: 22px;
        box-shadow: 0 10px 28px rgba(0,86,179,.18);
    }

        .dt-banner .code {
            display: inline-block;
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: .6px;
            padding: 4px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,.18);
            margin-right: 10px;
        }

        .dt-banner .status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 700;
            padding: 4px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,.18);
        }

            .dt-banner .status.cancelled {
                background: #b3261e;
            }

            .dt-banner .status::before {
                content: "";
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--dot, #fff);
            }

        .dt-banner h3 {
            color: #fff;
            font-weight: 800;
            margin: 14px 0 6px;
        }

        .dt-banner .sub {
            opacity: .92;
            font-size: 14px;
            margin: 0;
        }

    /* ===== Tiến trình ===== */
    .dt-steps-card {
        background: #fff;
        border: 1px solid var(--ap-line);
        border-radius: 16px;
        padding: 22px 26px 8px;
        margin-bottom: 22px;
    }

    .stepper-wrap {
        display: flex;
        justify-content: space-between;
        position: relative;
        margin: 18px 0 22px;
    }

        .stepper-wrap::before {
            content: '';
            position: absolute;
            top: 17px;
            left: 8%;
            right: 8%;
            height: 3px;
            background: #e6ecf2;
            z-index: 1;
        }

    .step-item {
        position: relative;
        z-index: 2;
        text-align: center;
        flex: 1;
    }

    .step-circle {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #fff;
        border: 2px solid #d5dde6;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 10px;
        font-weight: 700;
        font-size: 14px;
        color: #8a96a5;
        transition: all .25s;
    }

    .step-item.completed .step-circle {
        border-color: transparent;
        background: linear-gradient(135deg, #2b4c7e, #1f6fc2);
        color: #fff;
    }

    .step-item.active .step-circle {
        border-color: var(--ap-blue);
        color: var(--ap-blue);
        box-shadow: 0 0 0 5px rgba(0,86,179,.12);
    }

    .step-title {
        font-size: 13px;
        font-weight: 700;
        color: var(--ap-navy);
        margin-bottom: 2px;
    }

    .step-desc {
        font-size: 12px;
        color: var(--ap-muted);
    }

    /* ===== Thẻ thông tin ===== */
    .detail-card {
        background: #fff;
        border: 1px solid var(--ap-line);
        border-radius: 16px;
        margin-bottom: 22px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(23,40,75,.03);
    }

    /* Header thẻ: thanh dark blue, chữ trắng */
    .detail-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 14px 22px;
        background: var(--ap-head);
        color: var(--ap-head-text);
        border-bottom: 1px solid #c8d9ee;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

        .detail-card-head a.more {
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0;
            text-transform: none;
            color: var(--ap-blue);
        }

            .detail-card-head a.more:hover {
                color: var(--ap-navy);
            }

        /* badge trạng thái nằm trong header sáng */
        .detail-card-head .st {
            color: var(--ap-head-text);
        }

            .detail-card-head .st::before {
                background: #f0a500;
            }

            .detail-card-head .st.done {
                color: #138a7a;
            }

                .detail-card-head .st.done::before {
                    background: #1aa38f;
                }

    .detail-card-body {
        padding: 20px 22px;
    }

    .doc-avatar-lg {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 24px;
        font-weight: 700;
        background: linear-gradient(135deg, #2b4c7e, #1f6fc2);
    }

    .kv {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        padding: 11px 0;
        border-bottom: 1px solid #eef2f6;
        font-size: 14px;
    }

        .kv:last-child {
            border-bottom: 0;
        }

        .kv .k {
            color: var(--ap-muted);
            flex-shrink: 0;
        }

        .kv .v {
            font-weight: 700;
            color: var(--ap-navy);
            text-align: right;
        }

    .soft-box {
        background: #f4f8fc;
        border-radius: 12px;
        padding: 14px 16px;
        font-size: 13.5px;
        color: #44546b;
    }

        .soft-box b {
            color: var(--ap-navy);
        }

    /* Tiêu đề phụ trong thân thẻ: đậm, navy, có gạch xanh bên trái */
    .sub-title {
        font-size: 13.5px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        color: var(--ap-navy);
        margin: 18px 0 10px;
        padding-left: 10px;
        border-left: 3px solid var(--ap-blue);
    }

    .file-row {
        display: block;
        padding: 9px 14px;
        border: 1px solid var(--ap-line);
        border-left: 3px solid var(--ap-blue);
        border-radius: 10px;
        background: #fff;
        color: var(--ap-navy);
        font-size: 13.5px;
        text-decoration: none !important;
        transition: background .15s;
    }

        .file-row:hover {
            background: #f6f9fc;
        }

        .file-row .d {
            font-size: 12px;
            color: var(--ap-muted);
        }

    /* Trạng thái dạng chấm + chữ */
    .st {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: none;
        color: #44546b;
        white-space: nowrap;
    }

        .st::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #aab4c0;
        }

        .st.done {
            color: #138a7a;
        }

            .st.done::before {
                background: #1aa38f;
            }

    .pay-box {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        background: #f4f8fc;
        border-radius: 12px;
        padding: 16px 18px;
    }

        .pay-box .lbl {
            font-size: 13px;
            color: var(--ap-muted);
        }

        .pay-box .amt {
            font-size: 24px;
            font-weight: 800;
            color: var(--ap-navy);
            margin: 0;
        }

    .dx-box {
        border-left: 4px solid var(--ap-blue);
        background: #f4f8fc;
        border-radius: 0 12px 12px 0;
        padding: 14px 18px;
    }

        .dx-box .lbl {
            font-size: 12.5px;
            color: var(--ap-muted);
        }

        .dx-box .dx {
            font-size: 17px;
            font-weight: 800;
            color: var(--ap-navy);
            margin: 2px 0 0;
        }

    .rx-table {
        margin-bottom: 0;
    }

        .rx-table th {
            background: #e9f0f7;
            color: #44546b;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .4px;
            text-transform: uppercase;
            border-top: none;
        }

    /* ===== Modal ===== */
    .tk-modal .modal-content {
        border-radius: 16px;
        overflow: hidden;
    }

    .tk-modal .modal-header {
        background: var(--ap-bar);
        color: #fff;
        border-bottom: 0;
        padding: 14px 22px;
    }

    .tk-modal .modal-title {
        font-size: 15px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .tk-modal .close {
        color: #fff;
        opacity: .8;
        text-shadow: none;
    }

    .tk-modal .modal-footer {
        background: #f7fafd;
        border-top: 1px solid var(--ap-line);
    }

    .tk-modal .form-control {
        border-radius: 10px;
        border: 1px solid #d9e2ec;
    }

    @@media (max-width: 575px) {
        .step-desc {
            display: none;
        }

        .step-title {
            font-size: 11px;
        }

        .dt-banner {
            padding: 22px 20px;
        }
    }
</style>

<div class="container my-4 ap-font" style="min-height: 65vh;">
    <!-- Thanh công cụ -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <a asp-action="Index" class="btn btn-link pl-0 font-weight-bold" style="color:var(--ap-blue)">&larr; Quay lại danh sách lịch khám</a>
        <div class="mt-2 mt-md-0">
            <button type="button" class="btn btn-outline-secondary btn-sm mr-2" style="border-radius:8px" onclick="window.print()">In hồ sơ</button>
            <button type="button" class="btn btn-outline-secondary btn-sm mr-2" style="border-radius:8px" onclick="downloadIcs()">Thêm vào Calendar</button>
            @if (canCancel)
            {
                <button type="button" class="btn btn-outline-danger btn-sm" style="border-radius:8px" onclick="$('#cancelModal').modal('show')">Hủy ca khám</button>
            }
        </div>
    </div>

    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="border-radius:12px">
            @TempData["Msg"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    @if (TempData["Err"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" style="border-radius:12px">
            @TempData["Err"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Banner trạng thái -->
    <div class="dt-banner">
        <div class="row align-items-center">
            <div class="col-lg-8 mb-3 mb-lg-0">
                <div>
                    <span class="code">MÃ HỒ SƠ #TK-@Model.AppointId.ToString("D5")</span>
                    <span class="status @statusCls" style="--dot:@dotColor">@statusText</span>
                </div>
                <h3>Lịch hẹn lúc @Model.TimeText - @Model.DateText</h3>
                <p class="sub">Bác sĩ phụ trách: <b>@Model.DoctorName</b> &bull; Chuyên khoa: <b>@Model.SpecName</b></p>
            </div>
            <div class="col-lg-4 text-lg-right">
                @if (Model.CanPay)
                {
                    <a asp-action="Pay" asp-route-id="@Model.AppointId" class="btn btn-light btn-lg font-weight-bold px-4" style="border-radius:12px; color:var(--ap-blue)">
                        Thanh toán (@Cv.Money(Model.Amount))
                    </a>
                }
                else if (canJoinOnline)
                {
                    <a asp-action="Room" asp-route-id="@Model.AppointId" class="btn btn-light btn-lg font-weight-bold px-4" style="border-radius:12px; color:var(--ap-blue)">
                        Vào phòng khám video
                    </a>
                }
                else if (isCompleted)
                {
                    <button type="button" class="btn btn-outline-light font-weight-bold px-4" style="border-radius:12px" onclick="$('#rateModal').modal('show')">
                        Đánh giá bác sĩ
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Tiến trình 5 bước -->
    <div class="dt-steps-card">
        <div class="font-weight-bold" style="font-size:13.5px; letter-spacing:.6px; text-transform:uppercase; color:var(--ap-navy)">Tiến trình ca khám</div>
        <div class="stepper-wrap">
            <div class="step-item completed">
                <div class="step-circle"><i class="fa fa-check"></i></div>
                <div class="step-title">1. Đặt lịch</div>
                <div class="step-desc">Đã gửi yêu cầu</div>
            </div>
            <div class="step-item @(Model.HasPayment ? (Model.CanPay ? "active" : "completed") : "completed")">
                <div class="step-circle">
                    @if (Model.HasPayment && Model.CanPay)
                    {
                        <span>2</span>
                    }
                    else
                    {
                        <i class="fa fa-check"></i>
                    }
                </div>
                <div class="step-title">2. Thanh toán</div>
                <div class="step-desc">@(Model.CanPay ? "Chờ thanh toán" : "Đã thanh toán/Cọc")</div>
            </div>
            <div class="step-item @(Model.TrangThai == "Chờ xác nhận" ? "active" : (!isCancelled ? "completed" : ""))">
                <div class="step-circle">
                    @if (Model.TrangThai == "Chờ xác nhận")
                    {
                        <span>3</span>
                    }
                    else
                    {
                        <i class="fa fa-check"></i>
                    }
                </div>
                <div class="step-title">3. Bác sĩ duyệt</div>
                <div class="step-desc">@(Model.TrangThai == "Chờ xác nhận" ? "Đang chờ duyệt" : "Đã xác nhận")</div>
            </div>
            <div class="step-item @(Model.TrangThai == "Đã xác nhận" ? "active" : (isCompleted ? "completed" : ""))">
                <div class="step-circle">
                    @if (isCompleted)
                    {
                        <i class="fa fa-check"></i>
                    }
                    else
                    {
                        <span>4</span>
                    }
                </div>
                <div class="step-title">4. Khám bệnh</div>
                <div class="step-desc">@(isOnline ? "Khám Online HD" : "Tại phòng khám")</div>
            </div>
            <div class="step-item @(isCompleted ? "completed" : "")">
                <div class="step-circle">
                    @if (isCompleted)
                    {
                        <i class="fa fa-check"></i>
                    }
                    else
                    {
                        <span>5</span>
                    }
                </div>
                <div class="step-title">5. Kết quả &amp; đơn thuốc</div>
                <div class="step-desc">@(Model.HasRecord ? "Đã kê đơn" : "Đang cập nhật")</div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- CỘT TRÁI -->
        <div class="col-lg-6">
            <!-- Bác sĩ -->
            <div class="detail-card">
                <div class="detail-card-head">
                    <span>Bác sĩ phụ trách</span>
                    <a asp-controller="Doctors" asp-action="Index" class="more">Danh bạ bác sĩ &rarr;</a>
                </div>
                <div class="detail-card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="doc-avatar-lg mr-3">@initial</div>
                        <div>
                            <h5 class="font-weight-bold mb-1" style="color:var(--ap-navy)">@Model.DoctorName</h5>
                            <div class="small text-muted">Chuyên khoa: <b style="color:var(--ap-navy)">@Model.SpecName</b></div>
                            <div class="small text-muted">Trung tâm Y tế Telehealth Quốc tế</div>
                        </div>
                    </div>
                    <div class="soft-box">
                        <div class="mb-1"><b>Cơ sở tiếp nhận:</b> Phòng khám Đa khoa Telehealth</div>
                        <div><b>Địa chỉ:</b> 2 Cầu Giấy, Quận Cầu Giấy, Hà Nội</div>
                    </div>
                </div>
            </div>

            <!-- Chi tiết lịch hẹn -->
            <div class="detail-card">
                <div class="detail-card-head">
                    <span>Thông tin chi tiết lịch hẹn</span>
                </div>
                <div class="detail-card-body">
                    <div class="kv"><span class="k">Ngày khám</span><span class="v">@Model.DateText</span></div>
                    <div class="kv"><span class="k">Khung giờ hẹn</span><span class="v">@Model.TimeText</span></div>
                    <div class="kv">
                        <span class="k">Hình thức khám</span>
                        <span class="v">
                            @if (isOnline)
                            {
                                <text>Khám trực tuyến (Video Call)</text>
                            }
                            else if (isEmergency)
                            {
                                <text>Cấp cứu khẩn cấp</text>
                            }
                            else
                            {
                                <text>Khám trực tiếp tại viện</text>
                            }
                        </span>
                    </div>
                    @if (isEmergency && !string.IsNullOrEmpty(Model.MucDoKhanCap))
                    {
                        <div class="kv"><span class="k">Mức độ cấp cứu</span><span class="v">Mức @Model.MucDoKhanCap</span></div>
                        <div class="kv"><span class="k">Vị trí đón xe</span><span class="v">@Model.ViTriKhanCap</span></div>
                    }

                    <div class="sub-title">Hồ sơ / ảnh triệu chứng đính kèm</div>
                    @if (!Model.Files.Any())
                    {
                        <p class="text-muted small mb-0">Không có file đính kèm cho ca này.</p>
                    }
                    else
                    {
                        <div class="row">
                            @foreach (var f in Model.Files)
                            {
                                <div class="col-sm-6 mb-2">
                                    <a href="@Url.Action("Download", "Files", new { id = f.Id })" target="_blank" rel="noopener" class="file-row">
                                        <div class="font-weight-bold text-truncate">@f.Loai</div>
                                        <div class="d">@f.Ngay</div>
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI -->
        <div class="col-lg-6">
            <!-- Thanh toán -->
            <div class="detail-card">
                <div class="detail-card-head">
                    <span>Thanh toán &amp; hóa đơn</span>
                    @if (Model.CanPay)
                    {
                        <span class="st">Chờ thanh toán</span>
                    }
                    else if (Model.HasPayment)
                    {
                        <span class="st done">@Model.TrangThaiGiaoDich</span>
                    }
                </div>
                <div class="detail-card-body">
                    @if (Model.HasPayment)
                    {
                        <div class="pay-box">
                            <div>
                                <div class="lbl">@Model.LoaiGiaoDich</div>
                                <p class="amt">@Cv.Money(Model.Amount)</p>
                            </div>
                            @if (Model.CanPay)
                            {
                                <a asp-action="Pay" asp-route-id="@Model.AppointId" class="btn btn-primary font-weight-bold px-4" style="border-radius:10px">Quét mã VietQR</a>
                            }
                        </div>

                        @if (receiptFile != null)
                        {
                            <div class="sub-title">Ảnh biên lai đã gửi</div>
                            <a href="@Url.Action("Download", "Files", new { id = receiptFile.Id })" target="_blank" rel="noopener" class="d-inline-flex align-items-center">
                                <img src="@Url.Action("Download", "Files", new { id = receiptFile.Id })" alt="Biên lai" style="max-height: 90px; border-radius: 10px;" class="border" />
                                <span class="small ml-3" style="color:var(--ap-blue)">Xem ảnh lớn</span>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Ca khám cấp cứu hoặc miễn phí cọc không phát sinh khoản thanh toán trước.</p>
                    }
                </div>
            </div>

            <!-- Bệnh án & đơn thuốc -->
            <div class="detail-card">
                <div class="detail-card-head">
                    <span>Hồ sơ bệnh án &amp; đơn thuốc</span>
                    @if (Model.HasRecord)
                    {
                        <button type="button" class="btn btn-outline-primary btn-sm font-weight-bold" style="border-radius:8px" onclick="$('#rxModal').modal('show')">In đơn thuốc</button>
                    }
                </div>
                <div class="detail-card-body">
                    @if (!Model.HasRecord)
                    {
                        <div class="text-center py-4 text-muted">
                            <p class="mb-1">Bác sĩ chưa cập nhật kết quả và đơn thuốc cho ca khám này.</p>
                            <small>Kết quả sẽ hiển thị ngay sau khi buổi khám hoàn tất.</small>
                        </div>
                    }
                    else
                    {
                        <div class="dx-box mb-3">
                            <div class="lbl">Chẩn đoán của bác sĩ</div>
                            <p class="dx">@Model.ChanDoan</p>
                            @if (!string.IsNullOrEmpty(Model.NgayTaiKham))
                            {
                                <div class="d-flex justify-content-between align-items-center flex-wrap mt-3 pt-3" style="border-top:1px solid #dbe6f2">
                                    <div class="small">
                                        <span class="text-muted">Hẹn tái khám vào:</span>
                                        <b class="ml-1" style="color:var(--ap-navy)">@Model.NgayTaiKham</b>
                                    </div>
                                    <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-secondary btn-sm py-1 px-3 font-weight-bold" style="border-radius:8px; font-size:12.5px">Đặt lịch tái khám</a>
                                </div>
                            }
                        </div>

                        <div class="sub-title" style="margin-top:6px">Đơn thuốc được kê</div>
                        @if (!Model.Prescriptions.Any())
                        {
                            <p class="text-muted small mb-0">Không có đơn thuốc chỉ định.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered rx-table">
                                    <thead>
                                        <tr>
                                            <th>Tên thuốc</th>
                                            <th>Số lượng</th>
                                            <th>Liều dùng</th>
                                            <th>Cách dùng</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in Model.Prescriptions)
                                        {
                                            <tr>
                                                <td class="font-weight-bold" style="color:var(--ap-navy)">@p.TenThuoc</td>
                                                <td>@p.SoLuong</td>
                                                <td>@p.LieuDung</td>
                                                <td class="small text-muted">@p.CachDung</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex justify-content-between align-items-center flex-wrap mt-3 pt-3" style="border-top:1px solid var(--ap-line)">
                                <span class="small text-muted">Uống thuốc đúng giờ và đủ liều.</span>
                                <button type="button" class="btn btn-outline-secondary btn-sm" style="border-radius:8px" onclick="alert('Đã kích hoạt thông báo nhắc uống thuốc hàng ngày (08:00, 12:00, 20:00) qua hệ thống.')">Bật nhắc uống thuốc</button>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL IN ĐƠN THUỐC CHUẨN ================= -->
<div class="modal fade tk-modal ap-font" id="rxModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title">Đơn thuốc điện tử chuẩn Bộ Y tế</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4" id="printPrescription">
                <div class="d-flex justify-content-between flex-wrap pb-3 mb-3" style="border-bottom:1px solid var(--ap-line)">
                    <div>
                        <h5 class="font-weight-bold mb-1" style="color:var(--ap-navy)">BỆNH VIỆN ĐA KHOA QUỐC TẾ TELEHEALTH</h5>
                        <p class="small text-muted mb-0">Địa chỉ: 2 Cầu Giấy, Hà Nội - Hotline: 1900 1234</p>
                        <p class="small text-muted mb-0">Giấy phép hoạt động: 288/BYT-GPHĐ</p>
                    </div>
                    <div class="text-right">
                        <div class="font-weight-bold" style="color:var(--ap-blue)">MÃ ĐƠN: #DT-@Model.AppointId.ToString("D5")</div>
                        <small class="text-muted">Ngày khám: @Model.DateText</small>
                    </div>
                </div>

                <div class="row small mb-3">
                    <div class="col-6">
                        <div><b>Họ tên người bệnh:</b> Bệnh nhân Telehealth</div>
                        <div><b>Chẩn đoán:</b> @Model.ChanDoan</div>
                    </div>
                    <div class="col-6">
                        <div><b>Bác sĩ điều trị:</b> @Model.DoctorName</div>
                        <div><b>Chuyên khoa:</b> @Model.SpecName</div>
                        <div><b>Ngày tái khám:</b> @(!string.IsNullOrEmpty(Model.NgayTaiKham) ? Model.NgayTaiKham : "Theo chỉ định")</div>
                    </div>
                </div>

                <table class="table table-bordered table-sm small mb-3">
                    <thead style="background:#e9f0f7">
                        <tr>
                            <th style="width: 5%;">STT</th>
                            <th style="width: 40%;">Tên thuốc</th>
                            <th style="width: 15%;">Số lượng</th>
                            <th style="width: 20%;">Liều dùng</th>
                            <th style="width: 20%;">Cách dùng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int idx = 1;
                        }
                        @foreach (var p in Model.Prescriptions)
                        {
                            <tr>
                                <td class="text-center">@(idx++)</td>
                                <td class="font-weight-bold">@p.TenThuoc</td>
                                <td>@p.SoLuong</td>
                                <td>@p.LieuDung</td>
                                <td>@p.CachDung</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="soft-box mb-3">
                    <b>Lời dặn của bác sĩ:</b> Uống thuốc đúng liều lượng, nghỉ ngơi hợp lý, tránh thức khuya và tái khám đúng hẹn.
                </div>

                <div class="row pt-3">
                    <div class="col-6 text-center">
                        <i class="fa fa-qrcode" style="font-size: 50px;"></i>
                        <div class="small text-muted mt-1">Quét mã QR để tra cứu đơn thuốc điện tử</div>
                    </div>
                    <div class="col-6 text-center">
                        <div class="small text-muted mb-4">Ngày @DateTime.Now.ToString("dd/MM/yyyy")</div>
                        <div class="font-weight-bold">Bác sĩ khám bệnh</div>
                        <div class="font-italic mt-2 mb-1" style="font-family: cursive; font-size:18px; color:var(--ap-navy)">@Model.DoctorName</div>
                        <div class="small text-muted">(Đã ký số điện tử)</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm px-3 font-weight-bold" style="border-radius:8px" onclick="window.print()">In đơn thuốc</button>
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" style="border-radius:8px" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL ĐÁNH GIÁ BÁC SĨ ================= -->
<div class="modal fade tk-modal ap-font" id="rateModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <form asp-action="Rate" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.AppointId" />
                <div class="modal-header">
                    <h5 class="modal-title">Đánh giá dịch vụ &amp; bác sĩ</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4 text-center">
                    <h6 class="font-weight-bold" style="color:var(--ap-navy)">Đánh giá ca khám với @Model.DoctorName</h6>
                    <div class="my-3" style="font-size: 32px; color: #f2b01e; cursor: pointer;">
                        <i class="fa fa-star star-btn" data-v="1"></i>
                        <i class="fa fa-star star-btn" data-v="2"></i>
                        <i class="fa fa-star star-btn" data-v="3"></i>
                        <i class="fa fa-star star-btn" data-v="4"></i>
                        <i class="fa fa-star star-btn" data-v="5"></i>
                    </div>
                    <input type="hidden" name="rating" id="ratingInput" value="5" />
                    <div class="form-group text-left">
                        <label class="small font-weight-bold">Nhận xét của bạn (tùy chọn):</label>
                        <textarea name="comment" class="form-control" rows="3" placeholder="Bác sĩ khám thế nào? Bạn có hài lòng với phác đồ điều trị không?"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" style="border-radius:8px" data-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm px-3 font-weight-bold" style="border-radius:8px">Gửi đánh giá</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ================= MODAL HỦY LỊCH KHÁM ================= -->
<div class="modal fade tk-modal ap-font" id="cancelModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.AppointId" />
                <div class="modal-header">
                    <h5 class="modal-title">Hủy ca khám bệnh</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4">
                    <p>Bạn có chắc muốn hủy lịch khám #TK-@Model.AppointId.ToString("D5") với <b>@Model.DoctorName</b> vào ngày <b>@Model.DateText lúc @Model.TimeText</b>?</p>
                    <div class="form-group">
                        <label class="small font-weight-bold">Lý do hủy lịch:</label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="Vui lòng cung cấp lý do hủy để bệnh viện cải thiện phục vụ..."></textarea>
                    </div>
                    <div class="soft-box">
                        Tiền cọc đã thanh toán sẽ được xét hoàn theo quy định hoàn hủy lịch hẹn của bệnh viện.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" style="border-radius:8px" data-dismiss="modal">Quay lại</button>
                    <button type="submit" class="btn btn-danger btn-sm px-3 font-weight-bold" style="border-radius:8px">Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function downloadIcs() {
            var icsData = "BEGIN:VCALENDAR\nVERSION:2.0\nPRODID:-//Telehealth//Patient Portal//VI\nBEGIN:VEVENT\n" +
                "SUMMARY:Lich Kham Benh voi @Model.DoctorName\n" +
                "DESCRIPTION:Chuyen khoa @Model.SpecName. Hinh thuc: @Model.HinhThuc\n" +
                "LOCATION:Telehealth\n" +
                "STATUS:CONFIRMED\nEND:VEVENT\nEND:VCALENDAR";
            var blob = new Blob([icsData], { type: 'text/calendar;charset=utf-8;' });
            var link = document.createElement('a');
            link.href = window.URL.createObjectURL(blob);
            link.setAttribute('download', 'LichKham_@(Model.AppointId).ics');
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        $('.star-btn').click(function() {
            var v = parseInt($(this).data('v'));
            $('#ratingInput').val(v);
            $('.star-btn').each(function() {
                var cur = parseInt($(this).data('v'));
                if (cur <= v) {
                    $(this).removeClass('fa-star-o').addClass('fa-star');
                } else {
                    $(this).removeClass('fa-star').addClass('fa-star-o');
                }
            });
        });
    </script>
}
