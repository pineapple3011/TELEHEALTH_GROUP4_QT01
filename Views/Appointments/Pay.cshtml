@model TELEHEALTH_GROUP4_QT01.Models.ViewModels.PaymentVm
@{
    ViewData["Title"] = $"Thanh toán lịch khám #TK-{Model.AppointId:D5}";
}

<style>
    .qr-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e3e8ee;
        box-shadow: 0 8px 30px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .qr-header {
        background: linear-gradient(135deg, #1a2f23, #2c9d8f);
        color: #fff;
        padding: 20px;
        text-align: center;
    }

    .qr-box {
        background: #fbfdfc;
        border: 2px dashed #0056b3;
        border-radius: 16px;
        padding: 16px;
        display: inline-block;
        margin: 15px auto;
    }

    .copy-btn {
        cursor: pointer;
        color: #0056b3;
        background: #e8f5e9;
        border: none;
        border-radius: 6px;
        padding: 2px 8px;
        font-size: 11px;
        font-weight: 700;
        margin-left: 6px;
        transition: all .2s;
    }

        .copy-btn:hover {
            background: #2c9d8f;
            color: #fff;
        }

    .timer-badge {
        font-size: 15px;
        font-weight: 800;
        background: rgba(255,255,255,0.2);
        padding: 4px 14px;
        border-radius: 20px;
        display: inline-block;
        letter-spacing: 1px;
    }
</style>

<div class="container my-4" style="min-height: 65vh;">
    <!-- Breadcrumb -->
    <div class="mb-4">
        <a asp-action="Details" asp-route-id="@Model.AppointId" class="text-success small font-weight-bold">
            &larr; Xem chi tiết ca khám
        </a>
        <h3 class="font-weight-bold text-dark mt-1">
            <i class="fa fa-qrcode text-success mr-2"></i> Cổng Thanh Toán Trực Tuyến VietQR
        </h3>
        <p class="text-muted small mb-0">Hoàn tất thanh toán để bệnh viện tự động xác nhận lịch hẹn của bạn.</p>
    </div>

    @if (TempData["Err"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa fa-exclamation-triangle mr-2"></i> @TempData["Err"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="row">
        <!-- CỘT TRÁI: Tóm tắt đơn hàng & Thông tin ca khám -->
        <div class="col-lg-5 mb-4">
            <div class="card border-0 shadow-sm rounded-lg p-4 bg-white mb-4">
                <h6 class="font-weight-bold text-dark mb-3 border-bottom pb-2">
                    <i class="fa fa-receipt text-success mr-2"></i> Thông Tin Lịch Khám
                </h6>

                <div class="mb-3">
                    <span class="text-muted small d-block">Mã lịch khám:</span>
                    <span class="font-weight-bold text-dark" style="font-size:16px;">#TK-@Model.AppointId.ToString("D5")</span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Bác sĩ khám:</span>
                    <span class="font-weight-bold text-dark">@Model.DoctorName</span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Thời gian hẹn:</span>
                    <span class="font-weight-bold text-success">@Model.DateText lúc @Model.TimeText</span>
                </div>

                <div class="mb-3">
                    <span class="text-muted small d-block">Hình thức khám:</span>
                    <span class="badge badge-soft-primary px-3 py-1 font-weight-bold">@Model.HinhThuc</span>
                </div>

                <hr />

                <div class="p-3 bg-light rounded">
                    <span class="text-muted small d-block">@Model.LoaiGiaoDich:</span>
                    <h3 class="font-weight-bold text-success mb-0">@Cv.Money(Model.Amount)</h3>
                    <small class="text-muted">Đã bao gồm thuế GTGT &amp; bảo hiểm y tế số</small>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-lg p-3 bg-white">
                <h6 class="font-weight-bold small text-dark mb-2"><i class="fa fa-shield text-success"></i> Cam kết bảo mật &amp; an toàn:</h6>
                <p class="small text-muted mb-0">Giao dịch được bảo vệ bởi tiêu chuẩn mã hóa PCI DSS và hệ thống Napas247 liên ngân hàng. Khoản tiền cọc được hoàn 100% nếu bạn hủy trước 24 giờ.</p>
            </div>
        </div>

        <!-- CỘT PHẢI: Mã VietQR & Tải biên lai -->
        <div class="col-lg-7 mb-4">
            <div class="qr-card">
                <div class="qr-header">
                    <div class="timer-badge mb-2">
                        <i class="fa fa-clock-o mr-1"></i> Khung giờ được giữ chỗ: <span id="countdown">14:59</span>
                    </div>
                    <h5 class="text-white font-weight-bold mb-0">QUÉT MÃ VIETQR ĐỂ THANH TOÁN</h5>
                    <small class="text-light opacity-90">Mở bất kỳ ứng dụng ngân hàng hoặc ví điện tử để quét mã tự động điền</small>
                </div>

                <div class="p-4 text-center">
                    <div class="qr-box">
                        <img src="@Model.QrUrl" alt="Mã VietQR" style="max-width: 250px; width: 100%;" class="rounded" />
                    </div>

                    <!-- Bảng thông tin chuyển khoản chi tiết kèm nút copy -->
                    <div class="text-left bg-light p-3 rounded mb-4" style="font-size: 14px;">
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="text-muted">Ngân hàng thụ hưởng:</span>
                            <span class="font-weight-bold text-dark">@Model.BankId (Ngân hàng Quốc Dân)</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="text-muted">Số tài khoản:</span>
                            <div>
                                <span class="font-weight-bold text-dark" id="txtAccNo">@Model.AccountNo</span>
                                <button type="button" class="copy-btn" onclick="copyText('@Model.AccountNo')">Sao chép</button>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="text-muted">Chủ tài khoản:</span>
                            <span class="font-weight-bold text-dark">@Model.AccountName</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                            <span class="text-muted">Số tiền chuyển:</span>
                            <div>
                                <span class="font-weight-bold text-success" id="txtAmount">@Cv.Money(Model.Amount)</span>
                                <button type="button" class="copy-btn" onclick="copyText('@((long)Model.Amount)')">Sao chép</button>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between align-items-center py-2">
                            <span class="text-muted">Nội dung chuyển khoản:</span>
                            <div>
                                <span class="font-weight-bold text-danger" id="txtNote">@Model.TransferNote</span>
                                <button type="button" class="copy-btn" onclick="copyText('@Model.TransferNote')">Sao chép</button>
                            </div>
                        </div>
                    </div>

                    @if (Model.CanUpload)
                    {
                        <div class="border-top pt-4 text-left">
                            <h6 class="font-weight-bold text-dark mb-2">
                                <i class="fa fa-upload text-success mr-1"></i> Tải Lên Ảnh Chụp Biên Lai Chuyển Khoản:
                            </h6>
                            <p class="small text-muted mb-3">Sau khi chuyển khoản thành công trên app ngân hàng, vui lòng chụp màn hình và tải lên để được duyệt ca khám nhanh nhất.</p>

                            <form asp-action="Pay" asp-route-id="@Model.AppointId" method="post" enctype="multipart/form-data">
                                @Html.AntiForgeryToken()
                                <div class="form-group mb-3">
                                    <input type="file" name="receipt" accept=".jpg,.jpeg,.png,.pdf" class="form-control-file border p-2 rounded" required onchange="previewReceipt(this)" />
                                    <div id="receiptPreview" class="mt-2" style="display: none;">
                                        <img id="receiptImg" src="#" alt="Xem trước biên lai" style="max-height: 120px; border-radius: 8px;" class="border shadow-sm" />
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-success btn-block py-2 font-weight-bold shadow">
                                    <i class="fa fa-check-circle mr-1"></i> Xác nhận &amp; Gửi biên lai thanh toán
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-left p-3 mb-0">
                            <i class="fa fa-info-circle mr-1"></i> <b>Trạng thái: @Model.TrangThaiGiaoDich</b>. Bạn đã gửi biên lai thanh toán, hệ thống bệnh viện đang kiểm tra và sẽ gửi thông báo xác nhận trong ít phút.
                            <div class="mt-2">
                                <a asp-action="Details" asp-route-id="@Model.AppointId" class="btn btn-outline-primary btn-sm">Xem chi tiết lịch hẹn</a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyText(val) {
            navigator.clipboard.writeText(val).then(function() {
                alert("Đã sao chép: " + val);
            });
        }

        function previewReceipt(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#receiptImg').attr('src', e.target.result);
                    $('#receiptPreview').show();
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Countdown timer 15:00
        var timeLeft = 15 * 60;
        var timerEl = document.getElementById('countdown');
        var timer = setInterval(function() {
            timeLeft--;
            var mins = Math.floor(timeLeft / 60);
            var secs = timeLeft % 60;
            if (timerEl) {
                timerEl.innerText = (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;
            }
            if (timeLeft <= 0) {
                clearInterval(timer);
                if (timerEl) timerEl.innerText = "Hết hạn giữ chỗ";
            }
        }, 1000);
    </script>
}
