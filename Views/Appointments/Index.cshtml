@model List<TELEHEALTH_GROUP4_QT01.Models.ViewModels.AppointmentRow>
@{
    ViewData["Title"] = "Lịch khám của tôi";

    var total = Model.Count;
    var upcoming = Model.Count(r => r.TrangThai != "Đã hủy" && r.TrangThai != "Hoàn thành");
    var pendingConfirm = Model.Count(r => r.TrangThai == "Chờ xác nhận");
    var confirmed = Model.Count(r => r.TrangThai == "Đã xác nhận");
    var completed = Model.Count(r => r.TrangThai == "Hoàn thành");
    var cancelled = Model.Count(r => r.TrangThai == "Đã hủy");

    var tiles = new[]
    {
        (Key: "all", Label: "Tất cả ca khám", Count: total, Icon: "fa-calendar-o"),
        (Key: "upcoming", Label: "Sắp diễn ra", Count: upcoming, Icon: "fa-clock-o"),
        (Key: "pending", Label: "Chờ xác nhận", Count: pendingConfirm, Icon: "fa-hourglass-half"),
        (Key: "completed", Label: "Đã khám xong", Count: completed, Icon: "fa-check-circle-o"),        
        (Key: "cancelled", Label: "Đã hủy", Count: cancelled, Icon: "fa-times-circle-o")
    };
}

<style>
    :root {
        --ap-navy: #1d2b4f;
        --ap-bar: #17284b;
        --ap-blue: #0056b3;
        --ap-line: #e6ecf2;
        --ap-muted: #6b7785;
        --ap-head: #e9f0f7;
    }

    /* ===== Thẻ thống kê (đồng thời là bộ lọc) ===== */
    .stat-tile {
        display: flex;
        align-items: center;
        gap: 14px;
        height: 100%;
        padding: 16px 18px;
        background: #fff;
        border: 1px solid var(--ap-line);
        border-radius: 14px;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: transform .2s, box-shadow .2s, border-color .2s;
    }

        .stat-tile::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 3px;
            background: var(--ap-blue);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .25s;
        }

        .stat-tile:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(23,40,75,.08);
        }

        .stat-tile.active {
            border-color: #bcd2ea;
            box-shadow: 0 8px 20px rgba(0,86,179,.10);
        }

            .stat-tile.active::after {
                transform: scaleX(1);
            }

        .stat-tile .ico {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            flex-shrink: 0;
            background: #eaf1f9;
            color: #0056b3;
        }

        .stat-tile .num {
            font-size: 26px;
            font-weight: 800;
            line-height: 1;
            color: var(--ap-navy);
        }

        .stat-tile .lbl {
            font-size: 13px;
            color: var(--ap-muted);
            font-weight: 600;
            margin-top: 4px;
        }

    /* ===== Khung lưu ý ===== */
    .appt-note {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        background: #eaf3fb;
        border: 1px solid #d3e4f4;
        border-radius: 14px;
        padding: 14px 20px;
        margin-bottom: 20px;
        font-size: 14px;
        color: #33415c;
    }

        .appt-note .txt i {
            color: var(--ap-blue);
            margin-right: 8px;
        }

    /* ===== Khung danh sách ===== */
    .appt-panel {
        background: #fff;
        border: 1px solid var(--ap-line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 6px 22px rgba(23,40,75,.04);
    }

    .panel-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        background: var(--ap-bar);
        color: #fff;
        padding: 14px 22px;
    }

        .panel-bar .ttl {
            font-weight: 700;
            font-size: 14px;
            letter-spacing: .6px;
            text-transform: uppercase;
        }

            .panel-bar .ttl i {
                margin-right: 8px;
                opacity: .85;
            }

        .panel-bar .meta {
            font-size: 13px;
            opacity: .85;
        }

    .panel-tools {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding: 16px 22px;
        background: #f7fafd;
        border-bottom: 1px solid var(--ap-line);
    }

        .panel-tools .search {
            flex: 1 1 320px;
        }

        .panel-tools .type {
            flex: 0 0 240px;
        }

        .panel-tools .form-control {
            border-radius: 10px;
            border: 1px solid #d9e2ec;
        }

        .panel-tools .input-group-text {
            border-radius: 10px 0 0 10px;
            background: #fff;
            border-color: #d9e2ec;
            color: var(--ap-muted);
        }

        .panel-tools .input-group .form-control {
            border-radius: 0 10px 10px 0;
            border-left: 0;
        }

    /* ===== Bảng ===== */
    .appt-table {
        width: 100%;
        min-width: 920px;
        border-collapse: collapse;
        margin: 0;
    }

        .appt-table thead th {
            background: var(--ap-head);
            color: #44546b;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            padding: 12px 18px;
            border: 0;
            white-space: nowrap;
        }

        .appt-table tbody td {
            padding: 16px 18px;
            vertical-align: middle;
            border-top: 1px solid #eef2f6;
            font-size: 14px;
            color: #3c4858;
        }

        .appt-table tbody tr:hover {
            background: #f6f9fc;
        }

    .code-chip {
        display: inline-block;
        background: #eef3f9;
        color: var(--ap-navy);
        font-weight: 700;
        font-size: 13px;
        padding: 4px 10px;
        border-radius: 8px;
        white-space: nowrap;
    }

    .doc-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .doc-avatar {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-weight: 700;
        background: linear-gradient(135deg, #17284b, #0056b3);
    }

    .doc-name {
        font-weight: 700;
        color: var(--ap-navy);
        line-height: 1.25;
    }

    .doc-sub {
        font-size: 12.5px;
        color: var(--ap-muted);
    }

    .dt-date {
        font-weight: 700;
        color: var(--ap-navy);
    }

    .dt-time {
        font-size: 13px;
        color: var(--ap-muted);
        margin-top: 2px;
    }

        .dt-time i {
            margin-right: 5px;
        }

    .type-cell i {
        width: 18px;
        color: var(--ap-muted);
    }

    /* Trạng thái: chỉ tô màu cho kết quả cuối */
    .st {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
        font-weight: 600;
        color: #44546b;
        white-space: nowrap;
    }

        .st::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #aab4c0;
        }

        .st.confirmed::before {
            background: #0056b3;
        }

        .st.done {
            color: #138a7a;
        }

            .st.done::before {
                background: #1aa38f;
            }

        .st.cancelled {
            color: #c0392b;
        }

            .st.cancelled::before {
                background: #c0392b;
            }

    /* Nút thao tác */
    .act-cell {
        text-align: right;
        white-space: nowrap;
    }

        .act-cell .btn {
            font-size: 13px;
            font-weight: 600;
            border-radius: 8px;
            padding: 5px 13px;
            margin-left: 4px;
        }

        .act-cell .btn-link {
            padding-left: 8px;
            padding-right: 8px;
        }

    /* Chân bảng */
    .panel-foot {
        padding: 14px 22px;
        background: #f7fafd;
        border-top: 1px solid var(--ap-line);
        font-size: 13.5px;
        color: #44546b;
    }

        .panel-foot b {
            color: var(--ap-navy);
        }

    /* Modal */
    .tk-modal .modal-content {
        border-radius: 16px;
        overflow: hidden;
    }

    .tk-modal .modal-header {
        background: var(--ap-bar);
        color: #fff;
        border-bottom: 0;
        padding: 14px 22px;
    }

    .tk-modal .modal-title {
        font-size: 15px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .tk-modal .close {
        color: #fff;
        opacity: .8;
        text-shadow: none;
    }

    .tk-modal .modal-footer {
        background: #f7fafd;
        border-top: 1px solid var(--ap-line);
    }

    .tk-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 10px 0;
        border-bottom: 1px solid #eef2f6;
        font-size: 14px;
    }

        .tk-row:last-child {
            border-bottom: 0;
        }

        .tk-row span:first-child {
            color: var(--ap-muted);
        }

        .tk-row span:last-child {
            font-weight: 700;
            color: var(--ap-navy);
            text-align: right;
        }
</style>

<div class="container my-4" style="min-height: 65vh;">
    <!-- Thông báo -->
    @if (TempData["Msg"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" style="border-radius:12px">
            <i class="fa fa-check-circle mr-2"></i> @TempData["Msg"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <!-- Tiêu đề -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
        <div>
            <h3 class="font-weight-bold mb-1" style="color:var(--ap-navy)">Lịch khám của tôi</h3>
            <p class="text-muted mb-0 small">Theo dõi hồ sơ khám bệnh, lịch hẹn trực tuyến, phiếu khám và đơn thuốc điện tử</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary px-4 font-weight-bold" style="border-radius:10px">
                <i class="fa fa-plus-circle mr-1"></i> Đặt lịch khám mới
            </a>
        </div>
    </div>

    <!-- Thẻ thống kê / bộ lọc -->
    <div class="row">
        @foreach (var t in tiles)
        {
            <div class="col-6 col-md-4 col-lg mb-3">
                <div class="stat-tile @(t.Key == "all" ? "active" : "")" onclick="filterByStatus('@t.Key', this)">
                    <span class="ico"><i class="fa @t.Icon"></i></span>
                    <div>
                        <div class="num">@t.Count</div>
                        <div class="lbl">@t.Label</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Khung lưu ý -->
    @if (Model.Any())
    {
        <div class="appt-note">
            <div class="txt">
                <i class="fa fa-info-circle"></i>
                <b>Lưu ý:</b> Vui lòng có mặt trước giờ hẹn 10 phút, hoặc kiểm tra đường truyền nếu khám trực tuyến. Bạn có thể hủy lịch khi ca đang chờ xác nhận hoặc đã xác nhận.
            </div>
        </div>
    }

    <!-- Danh sách -->
    @if (!Model.Any())
    {
        <div class="appt-panel p-5 text-center my-4">
            <div class="mb-3">
                <i class="fa fa-calendar-times-o text-muted" style="font-size: 56px;"></i>
            </div>
            <h5 class="font-weight-bold" style="color:var(--ap-navy)">Bạn chưa có lịch khám nào trong hệ thống</h5>
            <p class="text-muted mb-3">Hãy chọn bác sĩ chuyên khoa phù hợp và đặt lịch khám ngay trên website.</p>
            <div>
                <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary px-4 py-2 font-weight-bold" style="border-radius:10px">
                    <i class="fa fa-user-md mr-1"></i> Tìm bác sĩ &amp; đặt lịch ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="appt-panel">
            <div class="panel-bar">
                <span class="ttl"><i class="fa fa-list-alt"></i> Danh sách lịch khám</span>
                <span class="meta">Hiển thị <b id="visibleCount">@total</b> / @total ca khám</span>
            </div>

            <div class="panel-tools">
                <div class="search">
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="fa fa-search"></i></span>
                        </div>
                        <input type="text" id="searchInput" onkeyup="filterAppointments()" class="form-control" placeholder="Tìm theo tên bác sĩ, ngày khám, mã #TK..." />
                    </div>
                </div>
                <div class="type">
                    <select id="typeFilter" onchange="filterAppointments()" class="form-control">
                        <option value="">Tất cả hình thức</option>
                        <option value="Online">Khám trực tuyến (Online)</option>
                        <option value="Offline">Khám trực tiếp (Tại viện)</option>
                        <option value="Cấp cứu">Cấp cứu khẩn cấp</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="appt-table" id="apptList">
                    <thead>
                        <tr>
                            <th>Mã ca</th>
                            <th>Bác sĩ</th>
                            <th>Ngày &amp; giờ khám</th>
                            <th>Hình thức</th>
                            <th>Trạng thái</th>
                            <th style="text-align:right">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            var isOnline = r.HinhThuc == "Online";
                            var isEmergency = r.HinhThuc == "Cấp cứu";
                            var isCompleted = r.TrangThai == "Hoàn thành";
                            var isCancelled = r.TrangThai == "Đã hủy";
                            var canCancel = (r.TrangThai == "Chờ xác nhận" || r.TrangThai == "Đã xác nhận");
                            var canJoinOnline = r.CanJoinRoom;
                            var waitingRoom = isOnline && !isCancelled && !isCompleted && !r.CanJoinRoom;

                            var dataStatus = isCancelled ? "cancelled" : (isCompleted ? "completed" : (r.TrangThai == "Chờ xác nhận" ? "pending" : "upcoming"));

                            var pillClass = isCancelled ? "cancelled" : (isCompleted ? "done" : (r.TrangThai == "Đã xác nhận" ? "confirmed" : "pending"));
                            var pillText = isCancelled ? "Đã hủy" : (isCompleted ? "Đã khám xong" : (r.TrangThai == "Đã xác nhận" ? "Đã xác nhận" : "Chờ xác nhận"));
                            var nameParts = (r.DoctorName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
                            var initial = nameParts.Length > 0 ? nameParts[nameParts.Length - 1].Substring(0, 1).ToUpper() : "B";

                            <tr class="appt-item-wrapper" data-status="@dataStatus" data-type="@r.HinhThuc" data-search="@r.DoctorName.ToLower() @r.DateText @r.AppointId @r.HinhThuc.ToLower()">
                                <td><span class="code-chip">TK-@r.AppointId.ToString("D5")</span></td>

                                <td>
                                    <div class="doc-cell">
                                        <div class="doc-avatar">@initial</div>
                                        <div>
                                            <div class="doc-name">@r.DoctorName</div>
                                            <div class="doc-sub">Bác sĩ chuyên khoa Telehealth</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="dt-date">@r.DateText</div>
                                    <div class="dt-time"><i class="fa fa-clock-o"></i>@r.TimeText</div>
                                </td>

                                <td>
                                    @if (isOnline)
                                    {
                                        <span class="type-cell"><i class="fa fa-video-camera"></i>Khám trực tuyến</span>
                                    }
                                    else if (isEmergency)
                                    {
                                        <span class="type-cell"><i class="fa fa-ambulance"></i>Cấp cứu</span>
                                    }
                                    else
                                    {
                                        <span class="type-cell"><i class="fa fa-hospital-o"></i>Khám trực tiếp</span>
                                    }
                                </td>

                                <td><span class="st @pillClass">@pillText</span></td>

                                <td class="act-cell">
                                    @if (canJoinOnline)
                                    {
                                        <a asp-action="Room" asp-route-id="@r.AppointId" class="btn btn-primary btn-sm">Vào phòng khám</a>
                                    }
                                    else if (waitingRoom)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm" disabled title="@r.RoomBlockedReason" style="cursor:not-allowed">Chờ duyệt thanh toán</button>
                                    }
                                    <a asp-action="Details" asp-route-id="@r.AppointId" class="btn btn-outline-secondary btn-sm">Chi tiết</a>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="openPrintModal('@r.AppointId', '@r.DoctorName', '@r.DateText', '@r.TimeText', '@r.HinhThuc')">In phiếu</button>
                                    @if (canCancel)
                                    {
                                        <button type="button" class="btn btn-link btn-sm text-danger" onclick="openCancelModal('@r.AppointId', '@r.DoctorName', '@r.DateText lúc @r.TimeText')">Hủy</button>
                                    }
                                    @if (isCompleted || isCancelled)
                                    {
                                        <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-secondary btn-sm">Đặt lại</a>
                                    }
                                </td>
                            </tr>
                        }
                        <tr id="emptyRow" style="display:none">
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="fa fa-inbox" style="font-size:34px"></i>
                                <div class="mt-2">Không có ca khám nào phù hợp với bộ lọc.</div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="panel-foot">
                Tổng cộng <b>@total</b> ca khám (<b>@completed</b> hoàn thành, <b>@cancelled</b> đã hủy)
            </div>
        </div>
    }
</div>

<!-- ================= MODAL IN PHIẾU HẸN KHÁM ================= -->
<div class="modal fade tk-modal" id="printModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-ticket mr-2"></i> Phiếu hẹn khám bệnh điện tử</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body p-4" id="printableTicket">
                <div class="text-center pb-3 mb-2" style="border-bottom:1px solid var(--ap-line)">
                    <h6 class="font-weight-bold mb-1" style="color:var(--ap-navy)">TRUNG TÂM Y TẾ &amp; TELEHEALTH QUỐC TẾ</h6>
                    <p class="small text-muted mb-2">2 Cầu Giấy, Hà Nội &middot; Hotline y tế: 1900 1234</p>
                    <span class="code-chip">Mã ca: <span id="mTicketId">#TK-00001</span></span>
                </div>

                <div class="tk-row"><span>Người khám</span><span>Bệnh nhân Telehealth</span></div>
                <div class="tk-row"><span>Bác sĩ khám</span><span id="mDoctorName">-</span></div>
                <div class="tk-row"><span>Thời gian hẹn</span><span id="mDateTime">-</span></div>
                <div class="tk-row"><span>Hình thức</span><span id="mBookingType">-</span></div>

                <div class="text-center py-3 mt-3" style="border:1px dashed #cdd6e0; border-radius:12px">
                    <i class="fa fa-barcode" style="font-size: 36px; letter-spacing: 4px;"></i>
                    <div class="small text-muted mt-1">Mã tra cứu tại quầy tiếp đón</div>
                </div>

                <p class="small text-muted text-center mt-3 mb-0">
                    <i class="fa fa-info-circle"></i> Vui lòng có mặt trước giờ hẹn 10 phút hoặc kiểm tra đường truyền nếu khám trực tuyến.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary btn-sm px-3" style="border-radius:8px" onclick="window.print()"><i class="fa fa-print mr-1"></i> In ngay</button>
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" style="border-radius:8px" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- ================= MODAL HỦY LỊCH HẸN ================= -->
<div class="modal fade tk-modal" id="cancelModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content border-0 shadow-lg">
            <form asp-action="Cancel" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="cancelApptId" />

                <div class="modal-header">
                    <h5 class="modal-title"><i class="fa fa-exclamation-triangle mr-2"></i> Xác nhận hủy lịch khám</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4">
                    <p>Bạn có chắc chắn muốn hủy lịch khám với <b id="cancelDocName">-</b> vào thời gian <b id="cancelTime">-</b> không?</p>
                    <div class="form-group">
                        <label class="font-weight-bold small">Lý do hủy lịch hẹn (tùy chọn):</label>
                        <textarea name="reason" class="form-control" rows="3" style="border-radius:10px" placeholder="Nhập lý do hủy (ví dụ: bận đột xuất, đã đỡ bệnh...)"></textarea>
                    </div>
                    <div class="appt-note mb-0" style="font-size:13px">
                        <div class="txt"><i class="fa fa-info-circle"></i> Nếu bạn đã thanh toán cọc giữ chỗ, bệnh viện sẽ xử lý hoàn trả theo chính sách y tế.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3" style="border-radius:8px" data-dismiss="modal">Giữ lại lịch</button>
                    <button type="submit" class="btn btn-danger btn-sm px-3 font-weight-bold" style="border-radius:8px">Xác nhận hủy lịch</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var currentFilterStatus = 'all';

        function filterByStatus(status, el) {
            $('.stat-tile').removeClass('active');
            $(el).addClass('active');
            currentFilterStatus = status;
            filterAppointments();
        }

        function filterAppointments() {
            var q = ($('#searchInput').val() || '').toLowerCase();
            var type = ($('#typeFilter').val() || '');

            var visible = 0;
            $('.appt-item-wrapper').each(function() {
                var item = $(this);
                var itemStatus = item.data('status');
                var itemType = item.data('type');
                var itemSearch = (item.data('search') || '').toString();

                var matchStatus = (currentFilterStatus === 'all') || (itemStatus === currentFilterStatus);
                var matchType = (!type) || (itemType === type);
                var matchSearch = (!q) || (itemSearch.indexOf(q) !== -1);

                if (matchStatus && matchType && matchSearch) {
                    item.show();
                    visible++;
                } else {
                    item.hide();
                }
            });
            $('#visibleCount').text(visible);
            $('#emptyRow').toggle(visible === 0);
        }

        function openPrintModal(id, doc, date, time, type) {
            document.getElementById('mTicketId').innerText = '#TK-' + String(id).padStart(5, '0');
            document.getElementById('mDoctorName').innerText = doc;
            document.getElementById('mDateTime').innerText = date + ' lúc ' + time;
            document.getElementById('mBookingType').innerText = type;
            $('#printModal').modal('show');
        }

        function openCancelModal(id, doc, timeStr) {
            document.getElementById('cancelApptId').value = id;
            document.getElementById('cancelDocName').innerText = doc;
            document.getElementById('cancelTime').innerText = timeStr;
            $('#cancelModal').modal('show');
        }
    </script>
}