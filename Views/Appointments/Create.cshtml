@model TELEHEALTH_GROUP4_QT01.Models.ViewModels.AppointmentCreateVm
@{
    ViewData["Title"] = "Đặt lịch khám bệnh";
}

<style>
    .bk-page {
        --bk-navy: #12295a;
        --bk-blue: #1a78c2;
        --bk-blue-dark: #145f9b;
        --bk-sky: #dbe6f6;
        --bk-sky-soft: #eef4fc;
        --bk-line: #e2e8f2;
        --bk-ink: #14233f;
        --bk-muted: #6b7a90;
        --bk-red: #d32f2f;
        --bk-shadow: 0 1px 2px rgba(16,40,90,.05), 0 8px 24px rgba(16,40,90,.06);
    }

    /* ===== Tiêu đề trang ===== */
    .bk-page .bk-head { margin-bottom: 24px; }
    .bk-page .bk-back { font-size: 13.5px; font-weight: 600; color: var(--bk-blue); }
    .bk-page .bk-back:hover { color: var(--bk-blue-dark); text-decoration: underline; }
    .bk-page .bk-head h3 {
        display: flex; align-items: center; gap: 12px; margin: 10px 0 6px;
        font-size: 26px; font-weight: 700; color: var(--bk-navy);
    }
    .bk-page .bk-head h3 .bk-head-ico {
        width: 42px; height: 42px; flex: none; display: inline-flex; align-items: center; justify-content: center;
        border-radius: 12px; background: var(--bk-sky); color: var(--bk-blue); font-size: 20px;
    }
    .bk-page .bk-head p { margin: 0; font-size: 14px; color: var(--bk-muted); }

    /* ===== Card + tiêu đề từng bước (giống card trang lịch khám) ===== */
    .bk-page .bk-card {
        background: #fff; border: 1px solid var(--bk-line); border-radius: 14px;
        box-shadow: var(--bk-shadow); overflow: hidden; margin-bottom: 22px;
    }
    .bk-page .bk-card-head {
        display: flex; align-items: center; gap: 12px; padding: 14px 22px;
        background: var(--bk-sky); border-bottom: 1px solid #cddbf0;
    }
    .bk-page .bk-card-head h6 {
        margin: 0; font-size: 13.5px; font-weight: 700; letter-spacing: .3px;
        text-transform: uppercase; color: var(--bk-navy);
    }
    .bk-page .bk-step {
        width: 28px; height: 28px; flex: none; display: inline-flex; align-items: center; justify-content: center;
        border-radius: 50%; background: linear-gradient(135deg, #12295a, #1a78c2);
        color: #fff; font-size: 13px; font-weight: 700;
    }
    .bk-page .bk-card-body { padding: 22px; }
    .bk-page .bk-side { position: sticky; top: 90px; }

    /* ===== Bác sĩ ===== */
    .bk-page .bk-avatar-img {
        display: block; width: 100%; max-height: 300px; object-fit: contain;
        background: var(--bk-sky-soft); border-radius: 12px;
    }
    .bk-page .bk-avatar-ph {
        width: 100%; height: 180px; display: flex; align-items: center; justify-content: center;
        border-radius: 12px; color: #fff; font-size: 40px; font-weight: 700;
        background: linear-gradient(135deg, #12295a, #1a78c2);
    }
    .bk-page .bk-doc-name { margin: 16px 0 10px; font-size: 19px; font-weight: 700; color: var(--bk-navy); }
    .bk-page .bk-kv {
        display: flex; justify-content: space-between; gap: 12px; padding: 9px 0;
        border-bottom: 1px solid #edf1f7; font-size: 13.5px;
    }
    .bk-page .bk-kv span { color: var(--bk-muted); }
    .bk-page .bk-kv b { color: var(--bk-ink); text-align: right; }
    .bk-page .bk-time {
        margin: 16px 0; padding: 14px 16px; border-radius: 12px;
        background: var(--bk-sky-soft); border-left: 4px solid var(--bk-blue);
    }
    .bk-page .bk-time-label { font-size: 12.5px; color: var(--bk-muted); margin-bottom: 4px; }
    .bk-page .bk-time-date { font-size: 16px; font-weight: 700; color: var(--bk-blue); }
    .bk-page .bk-time-slot { margin-top: 2px; font-size: 14.5px; font-weight: 600; color: var(--bk-ink); }

    /* ===== Chọn hình thức khám ===== */
    .bk-page .booking-type-card {
        position: relative; display: block; height: 100%; margin: 0; padding: 18px 16px;
        background: #fff; border: 2px solid var(--bk-line); border-radius: 14px;
        cursor: pointer; transition: border-color .2s, box-shadow .2s, background .2s;
    }
    .bk-page .booking-type-card:hover { border-color: #9cc3e8; box-shadow: 0 4px 16px rgba(26,120,194,.12); }
    .bk-page .booking-type-card.selected {
        border-color: var(--bk-blue); background: #f4f9fe; box-shadow: 0 6px 18px rgba(26,120,194,.18);
    }
    .bk-page .booking-type-card.bk-danger:hover { border-color: #efa6a6; box-shadow: 0 4px 16px rgba(211,47,47,.12); }
    .bk-page .booking-type-card.bk-danger.selected { border-color: var(--bk-red); background: #fff6f6; box-shadow: 0 6px 18px rgba(211,47,47,.16); }
    .bk-page .booking-type-card input[type="radio"] {
        position: absolute; top: 16px; right: 16px; margin: 0; width: 18px; height: 18px; accent-color: var(--bk-blue);
    }
    .bk-page .booking-type-card.bk-danger input[type="radio"] { accent-color: var(--bk-red); }
    .bk-page .bk-type-ico {
        width: 46px; height: 46px; margin-bottom: 12px; display: inline-flex; align-items: center; justify-content: center;
        border-radius: 12px; background: var(--bk-sky); color: var(--bk-blue); font-size: 22px;
    }
    .bk-page .bk-type-ico--navy { background: #e3e8f4; color: var(--bk-navy); }
    .bk-page .bk-type-ico--danger { background: #fdeceb; color: var(--bk-red); }
    .bk-page .booking-type-card h6 { margin: 0 0 4px; font-size: 15px; font-weight: 700; color: var(--bk-navy); }
    .bk-page .booking-type-card.bk-danger h6 { color: var(--bk-red); }
    .bk-page .booking-type-card p { margin: 0 0 10px; font-size: 12.5px; line-height: 1.5; color: var(--bk-muted); }
    .bk-page .bk-pill {
        display: inline-block; padding: 4px 11px; border-radius: 999px;
        background: var(--bk-sky); color: var(--bk-navy); font-size: 12px; font-weight: 700;
    }
    .bk-page .bk-pill--danger { background: #fdeceb; color: #a82334; }

    /* Khối phụ: cơ sở phòng khám / cấp cứu */
    .bk-page .bk-note { padding: 16px; margin-bottom: 14px; border-radius: 12px; background: var(--bk-sky-soft); border: 1px solid #d3e1f3; }
    .bk-page .bk-note label { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 600; color: var(--bk-navy); }
    .bk-page .bk-note .bk-hint { margin-top: 6px; font-size: 12.5px; color: var(--bk-muted); }
    .bk-page .bk-emergency {
        padding: 16px; margin-bottom: 14px; border-radius: 12px; background: #fffafa;
        border: 1px solid #f3c6c6; border-left: 5px solid var(--bk-red);
    }
    .bk-page .bk-emergency-head { display: flex; justify-content: space-between; align-items: center; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; }
    .bk-page .bk-emergency-head label { margin: 0; font-size: 14px; font-weight: 700; color: var(--bk-red); }

    /* ===== Triage ===== */
    .bk-page .triage-card {
        --c: #6c757d; --bg: #f8f9fa;
        display: flex; align-items: center; gap: 12px; margin: 0 0 10px; padding: 12px 14px;
        background: #fff; border: 1px solid var(--bk-line); border-left: 6px solid var(--c); border-radius: 10px;
        cursor: pointer; transition: background .15s, box-shadow .15s, transform .15s;
    }
    .bk-page .triage-card:hover { background: var(--bg); transform: translateX(3px); }
    .bk-page .triage-card:has(input:checked) { background: var(--bg); box-shadow: 0 0 0 2px var(--c); }
    .bk-page .triage-card input[type="radio"] { flex: none; margin: 0; width: 18px; height: 18px; accent-color: var(--c); }
    .bk-page .triage-card b { font-size: 14px; }
    .bk-page .triage-card .small { font-size: 12.5px; line-height: 1.45; }
    .bk-page .triage-tag {
        flex: none; padding: 3px 12px; border-radius: 999px; background: var(--c);
        color: #fff; font-size: 12px; font-weight: 700;
    }
    .bk-page .triage-1 { --c: #d32f2f; --bg: #fdeceb; }
    .bk-page .triage-2 { --c: #e0a100; --bg: #fff7dd; }
    .bk-page .triage-2 .triage-tag { color: #3d2c00; }
    .bk-page .triage-3 { --c: #1f9d68; --bg: #e6f6ee; }

    /* ===== Triệu chứng + tệp ===== */
    .bk-page .symptom-chip {
        display: inline-block; margin: 0 6px 8px 0; padding: 5px 13px; border-radius: 999px;
        background: var(--bk-sky-soft); color: #334a6b; border: 1px solid #d3e1f3;
        font-size: 12.5px; font-weight: 600; cursor: pointer; user-select: none; transition: all .15s;
    }
    .bk-page .symptom-chip:hover { background: var(--bk-blue); border-color: var(--bk-blue); color: #fff; }
    .bk-page .bk-label { display: block; margin-bottom: 6px; font-size: 13px; font-weight: 600; color: var(--bk-navy); }
    .bk-page .form-control {
        border: 1px solid #d5deeb; border-radius: 10px; color: var(--bk-ink); background: #fff;
    }
    .bk-page .form-control:focus { border-color: var(--bk-blue); box-shadow: 0 0 0 3px rgba(26,120,194,.16); }
    .bk-page select.form-control, .bk-page input.form-control { min-height: 44px; }
    .bk-page textarea.form-control { padding: 12px 14px; }
    .bk-page .bk-file {
        display: block; width: 100%; padding: 16px; border: 2px dashed #b9cfea; border-radius: 12px;
        background: var(--bk-sky-soft); color: var(--bk-muted); font-size: 13.5px; cursor: pointer;
    }
    .bk-page .bk-file:hover { border-color: var(--bk-blue); }
    .bk-page .bk-file-item {
        padding: 8px 12px; border: 1px solid var(--bk-line); border-radius: 10px; background: #fff;
        font-size: 12.5px; color: var(--bk-ink);
    }

    /* ===== Chi phí ===== */
    .bk-page .cost-box {
        padding: 18px; margin-bottom: 16px; border-radius: 12px;
        background: var(--bk-sky-soft); border: 1px dashed #8fb6e0;
    }
    .bk-page .bk-cost-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 10px; font-size: 14px; }
    .bk-page .bk-cost-row span:first-child { color: var(--bk-muted); }
    .bk-page .bk-cost-row b { color: var(--bk-ink); }
    .bk-page .bk-cost-row .bk-pay-mode { color: var(--bk-blue); font-weight: 700; }
    .bk-page .bk-cost-total { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 12px; border-top: 1px solid #cddbf0; }
    .bk-page .bk-cost-total > span { font-size: 15px; font-weight: 700; color: var(--bk-navy); }
    .bk-page .bk-cost-total h4 { margin: 0; font-size: 26px; font-weight: 700; color: var(--bk-blue); }
    .bk-page .bk-agree { margin-bottom: 18px; font-size: 13px; color: var(--bk-muted); }
    .bk-page .bk-agree input { accent-color: var(--bk-blue); }
    .bk-page .bk-agree a { color: var(--bk-blue); font-weight: 600; }

    /* ===== Nút ===== */
    .bk-page .bk-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 26px;
        border: 1px solid var(--bk-blue); border-radius: 10px; background: var(--bk-blue); color: #fff;
        font-size: 14.5px; font-weight: 600; line-height: 1.2; text-decoration: none; cursor: pointer;
        box-shadow: 0 6px 16px rgba(26,120,194,.28); transition: background .15s, box-shadow .15s;
    }
    .bk-page .bk-btn:hover { background: var(--bk-blue-dark); border-color: var(--bk-blue-dark); color: #fff; box-shadow: 0 8px 20px rgba(26,120,194,.35); }
    .bk-page .bk-btn--ghost { background: #fff; border-color: #c9d2df; color: #334a6b; box-shadow: none; }
    .bk-page .bk-btn--ghost:hover { background: #fff; border-color: var(--bk-blue); color: var(--bk-blue); box-shadow: none; }
    .bk-page .bk-btn--danger { background: var(--bk-red); border-color: var(--bk-red); box-shadow: 0 6px 16px rgba(211,47,47,.25); }
    .bk-page .bk-btn--danger:hover { background: #b71c1c; border-color: #b71c1c; box-shadow: 0 8px 20px rgba(211,47,47,.32); }
    .bk-page .bk-btn--sm { padding: 6px 14px; font-size: 12.5px; font-weight: 600; box-shadow: none; }
    .bk-page .bk-btn--block { display: flex; width: 100%; }
    .bk-page .bk-actions { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }

    @@media (max-width: 991px) {
        .bk-page .bk-side { position: static; }
    }
</style>

<div class="bk-page container my-4" style="min-height: 65vh;">
    <!-- Tiêu đề -->
    <div class="bk-head">
        <a class="bk-back" asp-controller="Doctors" asp-action="Details" asp-route-id="@Model.DoctorId">
            &larr; Quay lại chọn ngày/giờ khác
        </a>
        <h3>
            <span class="bk-head-ico"><i class="fa fa-calendar-plus-o"></i></span>
            Đặt lịch khám &amp; mô tả triệu chứng
        </h3>
        <p>Hoàn tất các bước dưới đây để gửi yêu cầu đặt lịch hẹn tới bác sĩ chuyên khoa.</p>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="createForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="DoctorId" />
        <input type="hidden" asp-for="ScheduleId" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm"></div>

        <div class="row">
            <!-- CỘT TRÁI: Bác sĩ & giờ khám đã chọn -->
            <div class="col-lg-4 mb-4">
                <div class="bk-side">
                    <div class="bk-card" style="margin-bottom:0">
                        <div class="bk-card-head">
                            <span class="bk-step">1</span>
                            <h6>Bác sĩ &amp; thời gian</h6>
                        </div>
                        <div class="bk-card-body">
                            @if (!string.IsNullOrEmpty(Model.DoctorAvatarUrl))
                            {
                                <img src="@Url.Content(Model.DoctorAvatarUrl)" alt="@Model.DoctorName" class="bk-avatar-img" />
                            }
                            else
                            {
                                <div class="bk-avatar-ph">BS</div>
                            }

                            <h5 class="bk-doc-name">@(Model.DoctorName ?? "Bác sĩ Chuyên khoa")</h5>
                            <div class="bk-kv"><span><i class="fa fa-stethoscope"></i> Chuyên khoa</span><b>@Model.SpecName</b></div>
                            <div class="bk-kv"><span><i class="fa fa-certificate"></i> Kinh nghiệm</span><b>@Cv.Years(Model.DoctorExp)</b></div>

                            <div class="bk-time">
                                <div class="bk-time-label">Thời gian khám đã chọn</div>
                                <div class="bk-time-date"><i class="fa fa-calendar"></i> @Model.DateText</div>
                                <div class="bk-time-slot"><i class="fa fa-clock-o"></i> Khung giờ: @(Model.TimeText ?? Model.Time)</div>
                                <input type="hidden" asp-for="Time" />
                                <span asp-validation-for="Time" class="text-danger small"></span>
                            </div>

                            <a asp-controller="Doctors" asp-action="Details" asp-route-id="@Model.DoctorId" class="bk-btn bk-btn--ghost bk-btn--sm bk-btn--block">
                                <i class="fa fa-pencil"></i> Đổi ngày hoặc giờ khác
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI -->
            <div class="col-lg-8 mb-4">
                <!-- BƯỚC 2: HÌNH THỨC KHÁM -->
                <div class="bk-card">
                    <div class="bk-card-head">
                        <span class="bk-step">2</span>
                        <h6>Chọn hình thức khám bệnh</h6>
                    </div>
                    <div class="bk-card-body">
                        <div class="row mb-3">
                            <!-- Khám trực tuyến -->
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label class="booking-type-card" id="cardOnline" for="typeOnline">
                                    <input type="radio" asp-for="HinhThuc" value="Online" id="typeOnline" onchange="updateBookingForm()" checked />
                                    <div class="bk-type-ico"><i class="fa fa-video-camera"></i></div>
                                    <h6>Khám trực tuyến</h6>
                                    <p>Tư vấn Video Call HD 1-1 với bác sĩ tại nhà</p>
                                    <span class="bk-pill">Phí: @Cv.Money(Model.FeeOnline)</span>
                                </label>
                            </div>

                            <!-- Khám trực tiếp -->
                            <div class="col-md-4 mb-3 mb-md-0">
                                <label class="booking-type-card" id="cardOffline" for="typeOffline">
                                    <input type="radio" asp-for="HinhThuc" value="Offline" id="typeOffline" onchange="updateBookingForm()" />
                                    <div class="bk-type-ico bk-type-ico--navy"><i class="fa fa-hospital-o"></i></div>
                                    <h6>Khám trực tiếp</h6>
                                    <p>Đến khám tại phòng khám của bệnh viện</p>
                                    <span class="bk-pill">Cọc 30%: @Cv.Money(Model.FeeOffline)</span>
                                </label>
                            </div>

                            <!-- Cấp cứu -->
                            <div class="col-md-4">
                                <label class="booking-type-card bk-danger" id="cardEmergency" for="typeEmergency">
                                    <input type="radio" asp-for="HinhThuc" value="Cấp cứu" id="typeEmergency" onchange="updateBookingForm()" />
                                    <div class="bk-type-ico bk-type-ico--danger"><i class="fa fa-ambulance"></i></div>
                                    <h6>Cấp cứu</h6>
                                    <p>Khẩn cấp 24/7, điều phối xe cứu thương</p>
                                    <span class="bk-pill bk-pill--danger">Miễn phí đặt trước</span>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="HinhThuc" class="text-danger small"></span>

                        <!-- Cơ sở phòng khám (khám trực tiếp) -->
                        <div id="clinicSection" class="bk-note" style="display: none;">
                            <label><i class="fa fa-map-marker" style="color:#d32f2f"></i> Chọn cơ sở phòng khám tiếp nhận:</label>
                            <select asp-for="ClinicId" asp-items="Model.Clinics" class="form-control">
                                <option value="">-- Vui lòng chọn cơ sở phòng khám --</option>
                            </select>
                            <span asp-validation-for="ClinicId" class="text-danger small"></span>
                            <div class="bk-hint">Khi khám trực tiếp, bạn đặt cọc 30% để bệnh viện giữ chỗ khung giờ với bác sĩ. Số tiền còn lại sẽ thanh toán tại quầy khi đến khám.</div>
                        </div>

                        <!-- Phân loại cấp cứu (Triage 1-3) -->
                        <div id="emergencySection" class="bk-emergency" style="display: none;">
                            <div class="bk-emergency-head">
                                <label><i class="fa fa-heartbeat"></i> Phân loại mức độ khẩn cấp (Triage 1-3):</label>
                                <a href="tel:115" class="bk-btn bk-btn--danger bk-btn--sm"><i class="fa fa-phone"></i> Gọi 115 ngay</a>
                            </div>

                            <label class="triage-card triage-1" for="t1">
                                <input type="radio" asp-for="MucDoKhanCap" value="1" id="t1" />
                                <div class="flex-grow-1">
                                    <b style="color:#d32f2f">Mức 1 - Nguy kịch (Cực kỳ khẩn cấp)</b>
                                    <div class="small text-muted">Ngừng tim, ngừng thở, mất tri giác, khó thở dữ dội, nghi ngờ đột quỵ não</div>
                                </div>
                                <span class="triage-tag">Đỏ</span>
                            </label>

                            <label class="triage-card triage-2" for="t2">
                                <input type="radio" asp-for="MucDoKhanCap" value="2" id="t2" />
                                <div class="flex-grow-1">
                                    <b style="color:#8a6100">Mức 2 - Ưu tiên khẩn cấp</b>
                                    <div class="small text-muted">Đau bụng cấp dữ dội, sốt cao co giật, vết thương chảy máu, chấn thương</div>
                                </div>
                                <span class="triage-tag">Vàng</span>
                            </label>

                            <label class="triage-card triage-3" for="t3">
                                <input type="radio" asp-for="MucDoKhanCap" value="3" id="t3" />
                                <div class="flex-grow-1">
                                    <b style="color:#1f9d68">Mức 3 - Cần xử lý sớm</b>
                                    <div class="small text-muted">Triệu chứng cấp tính nhưng dấu hiệu sinh tồn còn ổn định</div>
                                </div>
                                <span class="triage-tag">Xanh lá</span>
                            </label>
                            <span asp-validation-for="MucDoKhanCap" class="text-danger small"></span>

                            <div class="mt-3">
                                <div class="d-flex justify-content-between align-items-center flex-wrap mb-2" style="gap:8px">
                                    <label class="bk-label mb-0">Vị trí hiện tại của bạn để điều phối xe cứu thương:</label>
                                    <button type="button" class="bk-btn bk-btn--ghost bk-btn--sm" onclick="getLocation()">
                                        <i class="fa fa-crosshairs"></i> Lấy vị trí GPS tự động
                                    </button>
                                </div>
                                <input asp-for="ViTriKhanCap" id="locationInput" class="form-control" placeholder="Nhập số nhà, tên đường, phường/xã..." />
                                <span asp-validation-for="ViTriKhanCap" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BƯỚC 3: TRIỆU CHỨNG & TỆP ĐÍNH KÈM -->
                <div class="bk-card">
                    <div class="bk-card-head">
                        <span class="bk-step">3</span>
                        <h6>Mô tả triệu chứng &amp; tệp đính kèm</h6>
                    </div>
                    <div class="bk-card-body">
                        <div class="mb-2">
                            <label class="bk-label">Chọn nhanh triệu chứng thường gặp:</label>
                            <div>
                                <span class="symptom-chip" onclick="addSymptom('Sốt cao liên tục')">+ Sốt cao liên tục</span>
                                <span class="symptom-chip" onclick="addSymptom('Ho khan, đau họng')">+ Ho khan, đau họng</span>
                                <span class="symptom-chip" onclick="addSymptom('Khó thở, tức ngực')">+ Khó thở, tức ngực</span>
                                <span class="symptom-chip" onclick="addSymptom('Đau đầu, chóng mặt')">+ Đau đầu, chóng mặt</span>
                                <span class="symptom-chip" onclick="addSymptom('Đau bụng âm ỉ')">+ Đau bụng âm ỉ</span>
                                <span class="symptom-chip" onclick="addSymptom('Mẩn ngứa, dị ứng da')">+ Mẩn ngứa, dị ứng da</span>
                                <span class="symptom-chip" onclick="addSymptom('Mất ngủ kéo dài')">+ Mất ngủ kéo dài</span>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label class="bk-label">Lý do khám / Chi tiết tình trạng sức khỏe <span class="text-danger">*</span></label>
                            <textarea asp-for="LyDo" id="lyDoArea" class="form-control" rows="4" placeholder="Mô tả cụ thể triệu chứng của bạn, bắt đầu từ khi nào, đã dùng thuốc gì chưa..."></textarea>
                            <span asp-validation-for="LyDo" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-0">
                            <label class="bk-label">
                                <i class="fa fa-paperclip text-muted"></i> Tệp đính kèm (ảnh chụp triệu chứng, kết quả xét nghiệm, đơn thuốc cũ)
                            </label>
                            <input asp-for="Files" type="file" class="bk-file" multiple accept=".jpg,.jpeg,.png,.pdf" onchange="previewFiles(this)" />
                            <small class="text-muted d-block mt-2">Định dạng hỗ trợ: .jpg, .png, .pdf (Tối đa 5MB/tệp).</small>
                            <div id="filePreviewList" class="mt-2 row"></div>
                        </div>
                    </div>
                </div>

                <!-- BƯỚC 4: CHI PHÍ & XÁC NHẬN -->
                <div class="bk-card" style="margin-bottom:0">
                    <div class="bk-card-head">
                        <span class="bk-step">4</span>
                        <h6>Dự toán chi phí &amp; xác nhận</h6>
                    </div>
                    <div class="bk-card-body">
                        <div class="cost-box">
                            <div class="bk-cost-row">
                                <span>Giá niêm yết khám chuyên khoa:</span>
                                <b>@Cv.Money(Model.FeeOnline)</b>
                            </div>
                            <div class="bk-cost-row" id="depositRow">
                                <span id="depositLabel">Tỷ lệ thanh toán trước:</span>
                                <span class="bk-pay-mode" id="depositValue">100% (Khám Online)</span>
                            </div>
                            <div class="bk-cost-total">
                                <span>Số tiền cần thanh toán ngay:</span>
                                <h4 id="totalAmount">@Cv.Money(Model.FeeOnline)</h4>
                            </div>
                        </div>

                        <div class="form-check bk-agree">
                            <input class="form-check-input" type="checkbox" id="agreeTerms" checked required />
                            <label class="form-check-label" for="agreeTerms">
                                Tôi cam kết thông tin triệu chứng trên là hoàn toàn chính xác và đồng ý với <a href="#">chính sách đặt lịch y tế</a> của Telehealth.
                            </label>
                        </div>

                        <div class="bk-actions">
                            <a asp-controller="Doctors" asp-action="Index" class="bk-btn bk-btn--ghost">
                                &larr; Hủy &amp; Quay lại
                            </a>
                            <button type="submit" class="bk-btn">
                                Tiếp tục thanh toán &rarr;
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var feeOnline = @Model.FeeOnline;
        var feeOffline = @Model.FeeOffline;

        function updateBookingForm() {
            var checked = document.querySelector('input[name="HinhThuc"]:checked');
            var v = checked ? checked.value : 'Online';

            // Highlight cards
            $('#cardOnline').toggleClass('selected', v === 'Online');
            $('#cardOffline').toggleClass('selected', v === 'Offline');
            $('#cardEmergency').toggleClass('selected', v === 'Cấp cứu');

            document.getElementById('emergencySection').style.display = (v === 'Cấp cứu') ? 'block' : 'none';
            document.getElementById('clinicSection').style.display = (v === 'Offline') ? 'block' : 'none';

            // Update cost box
            if (v === 'Online') {
                document.getElementById('depositLabel').innerText = 'Thanh toán toàn phần (Online):';
                document.getElementById('depositValue').innerText = '100%';
                document.getElementById('totalAmount').innerText = formatMoney(feeOnline);
            } else if (v === 'Offline') {
                document.getElementById('depositLabel').innerText = 'Đặt cọc giữ chỗ (Offline):';
                document.getElementById('depositValue').innerText = '30%';
                document.getElementById('totalAmount').innerText = formatMoney(feeOffline);
            } else {
                document.getElementById('depositLabel').innerText = 'Chính sách cấp cứu:';
                document.getElementById('depositValue').innerText = 'Miễn phí cọc';
                document.getElementById('totalAmount').innerText = '0 đ';
            }
        }

        function formatMoney(num) {
            return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".") + " đ";
        }

        function addSymptom(text) {
            var area = document.getElementById('lyDoArea');
            if (area.value.trim().length > 0) {
                area.value += ', ' + text;
            } else {
                area.value = text;
            }
        }

        function getLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (pos) {
                    var lat = pos.coords.latitude.toFixed(5);
                    var lng = pos.coords.longitude.toFixed(5);
                    document.getElementById('locationInput').value = "Tọa độ GPS: " + lat + ", " + lng + " (Gần vị trí hiện tại)";
                }, function (err) {
                    alert("Không thể lấy vị trí tự động. Vui lòng gõ địa chỉ thủ công.");
                });
            } else {
                alert("Trình duyệt không hỗ trợ định vị GPS.");
            }
        }

        function previewFiles(input) {
            var preview = document.getElementById('filePreviewList');
            preview.innerHTML = '';
            if (input.files) {
                for (var i = 0; i < input.files.length; i++) {
                    var file = input.files[i];
                    var col = document.createElement('div');
                    col.className = 'col-sm-4 mb-2';
                    col.innerHTML = '<div class="bk-file-item text-truncate"><i class="fa fa-file" style="color:#1a78c2"></i> ' + file.name + ' (' + (file.size / 1024).toFixed(0) + ' KB)</div>';
                    preview.appendChild(col);
                }
            }
        }

        updateBookingForm();
    </script>
}
