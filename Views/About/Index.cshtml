                        <div class="ab-card-body">
                            <p class="text-muted small mb-4">Tỷ lệ tính trên tổng số lượt đặt khám trong hệ thống</p>
                            @if (!Model.Bars.Any())
                            {
                                <div class="ab-note mb-0"><i class="fa fa-info-circle"></i>Chưa có lượt đặt khám nào để thống kê.</div>
                            }
                            else
                            {
                                var rank = 1;
                                foreach (var b in Model.Bars)
                                {
                                    <div class="ab-bar">
                                        <div class="ab-bar-head">
                                            <span class="name"><span class="rk">@(rank++)</span>@b.Label</span>
                                            <span class="pct">@b.Percent%<span class="cnt">(@b.Count lượt)</span></span>
                                        </div>
                                        <div class="ab-track"><div class="ab-fill" style="width:@(b.Percent)%"></div></div>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="ab-card">
                        <div class="ab-card-head">Số liệu hệ thống</div>
                        <div class="ab-card-body">
                            <div class="ab-totals">
                                <div class="t"><div class="n">@Model.TotalDoctors</div><div class="l">Bác sĩ</div></div>
                                <div class="t"><div class="n">@Model.TotalPatients</div><div class="l">Bệnh nhân</div></div>
                                <div class="t"><div class="n">@Model.TotalAppointments</div><div class="l">Lượt khám</div></div>
                            </div>
                            <div class="ab-note"><i class="fa fa-info-circle"></i>Hệ thống hiện có <b>@Model.Services.Count</b> chuyên khoa đang có bác sĩ sẵn sàng nhận lịch.</div>
                            <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary btn-block font-weight-bold" style="border-radius:10px">Tìm bác sĩ ngay</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- TRANG THIẾT BỊ -->
    <section class="ab-sec" style="padding-top:0">
        <div class="container">
            <div class="ab-banner">
                <img src="~/img/bg-img/hinh5.jpg" alt="Phòng thông tim hiện đại" />
                <div class="in">
                    <h2>Trang thiết bị hiện đại</h2>
                    <p class="mb-0">Phòng khám và thủ thuật được trang bị máy móc chuẩn quốc tế, hỗ trợ bác sĩ chẩn đoán chính xác và an toàn.</p>
                    <ul>
                        <li><i class="fa fa-check-circle"></i> Chụp mạch và can thiệp tim</li>
                        <li><i class="fa fa-check-circle"></i> Siêu âm, theo dõi sinh hiệu</li>
                        <li><i class="fa fa-check-circle"></i> Kết quả lưu trong hồ sơ cá nhân</li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <!-- DANH SÁCH DỊCH VỤ -->
    <section class="ab-sec soft">
        <div class="container">
            <div class="ab-title center">
                <span class="kicker">Chuyên khoa</span>
                <h2>Danh sách dịch vụ</h2>
                <p>Các chuyên khoa đang có bác sĩ trên hệ thống</p>
            </div>

            @if (!Model.Services.Any())
            {
                <div class="ab-note"><i class="fa fa-info-circle"></i>Chưa có chuyên khoa nào.</div>
            }
            else
            {
                <div class="sv-grid">
                    @for (var i = 0; i < Model.Services.Count; i++)
                    {
                        var s = Model.Services[i];
                        <div class="sv-card">
                            <div class="ico"><i class="fa @Icon(s.Name, i)"></i></div>
                            <div class="nm">@s.Name</div>
                            <div class="meta">
                                <span>@s.DoctorCount bác sĩ</span>
                                <span>@s.AppointmentCount lượt khám</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- TẠI SAO CHỌN -->
    <section class="ab-sec">
        <div class="container">
            <div class="ab-title center">
                <span class="kicker">Lợi ích</span>
                <h2>Tại sao chọn chúng tôi?</h2>
                <p>Những điểm giúp việc khám chữa bệnh của bạn trở nên đơn giản hơn.</p>
            </div>
            <div class="ab-why">
                <div class="c"><div class="ic"><i class="fa fa-lock"></i></div><h6>Bảo mật thông tin</h6><p>Hồ sơ bệnh án và lịch sử khám được lưu trữ riêng cho từng bệnh nhân trên hệ thống.</p></div>
                <div class="c"><div class="ic"><i class="fa fa-user-md"></i></div><h6>Đội ngũ bác sĩ chuyên khoa</h6><p>Bác sĩ thuộc nhiều chuyên khoa, thông tin kinh nghiệm và phí khám công khai, rõ ràng.</p></div>
                <div class="c"><div class="ic"><i class="fa fa-clock-o"></i></div><h6>Tiết kiệm thời gian, chi phí</h6><p>Chọn giờ trống trực tiếp trên lịch, không cần chờ bốc số, theo dõi đơn khám mọi lúc.</p></div>
                <div class="c"><div class="ic"><i class="fa fa-qrcode"></i></div><h6>Thanh toán thuận tiện</h6><p>Quét mã VietQR bằng ứng dụng ngân hàng, gửi biên lai và được xác nhận nhanh chóng.</p></div>
                <div class="c"><div class="ic"><i class="fa fa-file-text-o"></i></div><h6>Đơn thuốc điện tử</h6><p>Chẩn đoán, đơn thuốc và lịch tái khám được lưu sẵn, xem và in lại bất cứ lúc nào.</p></div>
                <div class="c"><div class="ic"><i class="fa fa-ambulance"></i></div><h6>Hỗ trợ cấp cứu</h6><p>Phân loại mức độ khẩn cấp và ghi nhận vị trí để ưu tiên xử lý các ca nguy cấp.</p></div>
            </div>
        </div>
    </section>

    <!-- ĐỘI NGŨ BÁC SĨ -->
    <section class="ab-sec soft">
        <div class="container">
            <div class="ab-team">
                <div class="img">
                    <img src="~/img/bg-img/hinh2.jpg" alt="Đội ngũ bác sĩ" />
                    <div class="badge-num">@Model.TotalDoctors bác sĩ · @Model.Services.Count chuyên khoa</div>
                </div>
                <div class="txt">
                    <div class="ab-title">
                        <span class="kicker">Đội ngũ</span>
                        <h2>Nơi hội tụ đội ngũ bác sĩ</h2>
                    </div>
                    <p class="text-muted mb-3">
                        Hệ thống hiện có @Model.TotalDoctors bác sĩ thuộc @Model.Services.Count chuyên khoa,
                        sẵn sàng tư vấn và thăm khám theo lịch bạn chọn.
                    </p>
                    <ul>
                        <li><i class="fa fa-check-circle"></i>Thông tin chuyên khoa, kinh nghiệm minh bạch</li>
                        <li><i class="fa fa-check-circle"></i>Phí khám công khai trước khi đặt lịch</li>
                        <li><i class="fa fa-check-circle"></i>Đánh giá sau khám giúp nâng cao chất lượng</li>
                    </ul>
                    <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary px-4 font-weight-bold" style="border-radius:10px">Xem đội ngũ bác sĩ</a>
                </div>
            </div>
        </div>
    </section>

    <!-- KÊU GỌI HÀNH ĐỘNG -->
    <section class="ab-sec">
        <div class="container">
            <div class="ab-cta">
                <div>
                    <h3>Sẵn sàng đặt lịch khám?</h3>
                    <p>Chọn bác sĩ phù hợp và đặt lịch chỉ trong vài phút.</p>
                </div>
                <a asp-controller="Doctors" asp-action="Index" class="btn btn-light">Đặt lịch ngay</a>
            </div>
        </div>
    </section>

</div>
