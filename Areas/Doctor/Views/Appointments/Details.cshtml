@model AppointmentDetailVm
@{
    ViewData["Title"] = "Chi tiết ca khám";
    var a = Model.Appointment;
    var p = Model.Patient;

    var statusText = a.IsPending ? "Chờ xác nhận" : a.IsConfirmed ? "Đã xác nhận" : a.IsCompleted ? "Đã khám xong" : "Đã hủy";
    var statusCls = a.IsCancelled ? "cancelled" : "";
    var stClass = a.IsCancelled ? "cancelled" : a.IsCompleted ? "done" : a.IsConfirmed ? "confirmed" : "pending";
    var dotColor = a.IsCompleted ? "#7fe9d6" : "#ffffff";

    var hinhThucText = a.BookingType == "Online" ? "Khám trực tuyến (Video Call)"
        : a.BookingType == "Cấp cứu" ? "Cấp cứu khẩn cấp"
        : "Khám trực tiếp tại viện";
}

<style>
    :root {
        --ap-navy: #1d2b4f;
        --ap-bar: #2b4c7e;
        --ap-head-bg: #dce8f8; /* nền xanh nhạt cho tiêu đề khối */
        --ap-head-line: #cfdcef; /* đường viền dưới tiêu đề */
        --ap-blue: #0056b3;
        --ap-line: #e6ecf2;
        --ap-muted: #6b7785;
        --ap-font: inherit;
    }

    /* ===== Đồng bộ font (không đụng tới icon FontAwesome) ===== */
    .ap-font,
    .ap-font *:not(.fa):not(.fas):not(.far):not(i) {
        font-family: var(--ap-font);
    }

    /* ===== Banner ===== */
    .dt-banner {
        background: linear-gradient(135deg, #2b4c7e, #1f6fc2);
        border-radius: 18px;
        padding: 28px 32px;
        color: #fff;
        margin-bottom: 22px;
        box-shadow: 0 10px 28px rgba(0,86,179,.18);
    }

        .dt-banner .code {
            display: inline-block;
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: .6px;
            padding: 4px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,.18);
            margin-right: 10px;
        }

        .dt-banner .status {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 700;
            padding: 4px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,.18);
        }

            .dt-banner .status.cancelled {
                background: #b3261e;
            }

            .dt-banner .status::before {
                content: "";
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--dot, #fff);
            }

        .dt-banner h3 {
            color: #fff;
            font-weight: 800;
            margin: 14px 0 6px;
        }

        .dt-banner .sub {
            opacity: .92;
            font-size: 14px;
            margin: 0;
        }

    /* ===== Thẻ thông tin ===== */
    .detail-card {
        background: #fff;
        border: 1px solid var(--ap-line);
        border-radius: 16px;
        margin-bottom: 22px;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(23,40,75,.03);
    }

    .detail-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 14px 22px;
        background: var(--ap-head-bg);
        color: var(--ap-navy);
        border-bottom: 1px solid var(--ap-head-line);
        font-weight: 700;
        font-size: 15px;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

        /* Nếu sau này có link nhỏ ở bên phải tiêu đề (giống "Danh bạ bác sĩ →") */
        .detail-card-head a {
            color: var(--ap-blue);
            font-size: 12.5px;
            font-weight: 600;
            text-transform: none;
            letter-spacing: 0;
        }

    .dt-banner .sub, .dt-banner .sub b {
        color: #fff !important;
    }

    .detail-card-body {
        padding: 20px 22px;
    }

    .kv {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        padding: 11px 0;
        border-bottom: 1px solid #eef2f6;
        font-size: 14px;
    }

        .kv:last-child {
            border-bottom: 0;
        }

        .kv .k {
            color: var(--ap-muted);
            flex-shrink: 0;
        }

        .kv .v {
            font-weight: 700;
            color: var(--ap-navy);
            text-align: right;
            word-break: break-word;
        }

            .kv .v.danger {
                color: #c0392b;
            }

    /* Trạng thái dạng chấm + chữ */
    .st {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
        font-weight: 700;
        color: #44546b;
        white-space: nowrap;
    }

        .st::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #aab4c0;
        }

        .st.done {
            color: #138a7a;
        }

            .st.done::before {
                background: #1aa38f;
            }

        .st.confirmed::before {
            background: #0056b3;
        }

        .st.cancelled {
            color: #c0392b;
        }

            .st.cancelled::before {
                background: #c0392b;
            }

        .st.warning {
            color: #9a6a00;
        }

            .st.warning::before {
                background: #e0a100;
            }

    .pay-box {
        background: #f4f8fc;
        border-radius: 12px;
        padding: 16px 18px;
        margin-bottom: 8px;
    }

        .pay-box .lbl {
            font-size: 13px;
            color: var(--ap-muted);
        }

        .pay-box .amt {
            font-size: 24px;
            font-weight: 800;
            color: var(--ap-navy);
            margin: 2px 0 0;
        }

    .empty-text {
        color: var(--ap-muted);
        font-size: 14px;
        margin: 0;
    }

    .toolbar .btn {
        font-weight: 600;
        border-radius: 8px;
    }
</style>

<div class="container my-4 ap-font" style="min-height: 55vh;">
    <!-- Thanh công cụ -->
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 toolbar">
        <a asp-action="Index" asp-route-date="@a.Date.ToString("yyyy-MM-dd")" class="btn btn-link pl-0 font-weight-bold" style="color:var(--ap-blue)">&larr; Quay lại danh sách</a>
        <div class="mt-2 mt-md-0">
            @if (a.IsPending)
            {
                <form asp-action="Confirm" asp-route-id="@a.AppointId" asp-route-date="@a.Date.ToString("yyyy-MM-dd")" method="post" class="d-inline"><button class="btn btn-primary btn-sm px-3">Xác nhận ca</button></form>
            }
            @if (a.IsConfirmed && a.BookingType == "Online")
            {
                if (a.CanEnterRoom)
                {
                    <a asp-action="Room" asp-route-id="@a.AppointId" class="btn btn-outline-primary btn-sm px-3 ml-1"><i class="fa fa-video-camera"></i> Vào phòng khám online</a>
                }
                else
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm px-3 ml-1" disabled title="@a.RoomBlockedReason" style="cursor:not-allowed"><i class="fa fa-video-camera"></i> Chờ admin duyệt thanh toán</button>
                }
            }
            @if (a.IsConfirmed)
            {
                <a asp-controller="Consultations" asp-action="Exam" asp-route-id="@a.AppointId" class="btn btn-primary btn-sm px-3 ml-1">Bắt đầu khám</a>
            }
            @if (a.IsCompleted)
            {
                <a asp-controller="Consultations" asp-action="Exam" asp-route-id="@a.AppointId" class="btn btn-outline-secondary btn-sm px-3 ml-1">Xem / sửa bệnh án</a>
            }
        </div>
    </div>

    <!-- Banner -->
    <div class="dt-banner">
        <div>
            <span class="code">MÃ CA @a.Code</span>
            <span class="status @statusCls" style="--dot:@dotColor">@statusText</span>
        </div>
        <h3>Lịch hẹn lúc @a.TimeText - @a.Date.ToString("dd/MM/yyyy")</h3>
        <p class="sub">Bệnh nhân: <b>@p.FullName</b> &bull; Hình thức: <b>@hinhThucText</b></p>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <!-- Thông tin ca khám -->
            <div class="detail-card">
                <div class="detail-card-head">
                    <span>Thông tin ca khám @a.Code</span>
                </div>
                <div class="detail-card-body">
                    <div class="kv"><span class="k">Ngày khám</span><span class="v">@a.Date.ToString("dd/MM/yyyy")</span></div>
                    <div class="kv"><span class="k">Giờ hẹn</span><span class="v">@a.TimeText</span></div>
                    <div class="kv"><span class="k">Hình thức</span><span class="v">@a.BookingType</span></div>
                    @if (!string.IsNullOrEmpty(a.ClinicName))
                    {
                        <div class="kv"><span class="k">Phòng khám</span><span class="v">@a.ClinicName</span></div>
                    }
                    @if (a.BookingType == "Cấp cứu")
                    {
                        <div class="kv"><span class="k">Vị trí cấp cứu</span><span class="v">@(a.EmergencyLocation ?? "-")</span></div>
                        <div class="kv"><span class="k">Phân loại</span><span class="v danger">Mức @(a.TriageLevel ?? "-")</span></div>
                    }
                    <div class="kv">
                        <span class="k">Trạng thái</span>
                        <span class="v">
                            <span class="st @stClass">@statusText</span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- Thanh toán -->
            <div class="detail-card">
                <div class="detail-card-head">
                    <span>Thanh toán</span>
                </div>
                <div class="detail-card-body">
                    @if (Model.Payment == null)
                    {
                        <p class="empty-text">Chưa có giao dịch cho ca khám này.</p>
                    }
                    else
                    {
                        <div class="pay-box">
                            <div class="lbl">Số tiền</div>
                            <p class="amt">@Model.Payment.Amount.ToString("N0") đ</p>
                        </div>
                        <div class="kv"><span class="k">Phương thức</span><span class="v">@Model.Payment.Method</span></div>
                        <div class="kv">
                            <span class="k">Trạng thái</span>
                            <span class="v"><span class="st @(Model.Payment.Status == "Đã thanh toán" ? "done" : "warning")">@Model.Payment.Status</span></span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <!-- Bệnh nhân -->
            <div class="detail-card">
                <div class="detail-card-head">
                    <span>Bệnh nhân</span>
                </div>
                <div class="detail-card-body">
                    <div class="kv"><span class="k">Họ tên</span><span class="v">@p.FullName</span></div>
                    <div class="kv"><span class="k">Điện thoại</span><span class="v">@p.Phone</span></div>
                    <div class="kv"><span class="k">Email</span><span class="v">@p.Email</span></div>
                    <div class="kv"><span class="k">Địa chỉ</span><span class="v">@(p.Address ?? "-")</span></div>
                    <div class="kv"><span class="k">SĐT người thân</span><span class="v">@(p.EmergencyPhone ?? "-")</span></div>
                </div>
            </div>

            <!-- Tệp đính kèm -->
            <div class="detail-card">
                <div class="detail-card-head">
                    <span>Tệp bệnh nhân đính kèm (@Model.Files.Count)</span>
                </div>
                <div class="detail-card-body">
                    <partial name="_FileGrid" model="Model.Files" />
                </div>
            </div>
        </div>
    </div>
</div>
