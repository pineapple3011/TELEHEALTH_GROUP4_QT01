@model List<AppointmentRowVm>
@{
    ViewData["Title"] = "Tổng số ca khám";
    var status = (ViewBag.Status as string) ?? "all";

    // Cần xác nhận lên đầu, rồi đã xác nhận, hoàn thành, đã hủy.
    // Ca sắp tới xếp gần nhất trước; ca đã xong/hủy xếp mới nhất trước.
    var rows = Model
        .OrderBy(a => a.IsPending ? 0 : a.IsConfirmed ? 1 : a.IsCompleted ? 2 : 3)
        .ThenBy(a => (a.IsPending || a.IsConfirmed ? 1L : -1L) * (a.Date + a.Time).Ticks)
        .ToList();

    int cAll = rows.Count,
        cPending = rows.Count(r => r.IsPending),
        cConfirmed = rows.Count(r => r.IsConfirmed),
        cCompleted = rows.Count(r => r.IsCompleted),
        cCancelled = rows.Count(r => r.IsCancelled);

    var tabs = new[]
    {
        (Key: "all", Label: "Tất cả", Count: cAll),
        (Key: "pending", Label: "Cần xác nhận", Count: cPending),
        (Key: "confirmed", Label: "Đã xác nhận", Count: cConfirmed),
        (Key: "completed", Label: "Đã khám xong", Count: cCompleted),
        (Key: "cancelled", Label: "Đã hủy", Count: cCancelled)
    };
}

<style>
    :root {
        --ap-navy: #1d2b4f;
        --ap-bar: #2b4c7e;
        --ap-blue: #0056b3;
        --ap-line: #e6ecf2;
        --ap-muted: #6b7785;
        --ap-head: #e9f0f7;
        /* Nếu tiêu đề trang dùng font riêng, thay inherit bằng font đó, VD: "Be Vietnam Pro", sans-serif */
        --ap-font: inherit;
    }

    /* ===== Đồng bộ font (không đụng tới icon FontAwesome) ===== */
    .ap-font,
    .ap-font *:not(.fa):not(.fas):not(.far):not(i) {
        font-family: var(--ap-font);
    }

    .search-box {
        max-width: 280px;
        border-radius: 10px;
        border: 1px solid #d9e2ec;
    }

    /* ===== Khung lưu ý ===== */
    .appt-note {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #eaf3fb;
        border: 1px solid #d3e4f4;
        border-radius: 14px;
        padding: 13px 20px;
        margin-bottom: 18px;
        font-size: 14px;
        color: #33415c;
    }

        .appt-note i {
            color: var(--ap-blue);
        }

    /* ===== Tab lọc ===== */
    .tab-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 18px;
    }

    .tab-btn {
        border: 1px solid #d9e2ec;
        background: #fff;
        border-radius: 999px;
        padding: 8px 16px;
        font-weight: 600;
        font-size: 14px;
        color: #44546b;
        cursor: pointer;
        transition: all .15s;
    }

        .tab-btn:hover {
            border-color: var(--ap-blue);
            color: var(--ap-blue);
        }

        .tab-btn.active {
            background: var(--ap-bar);
            border-color: var(--ap-bar);
            color: #fff;
        }

        .tab-btn .cnt {
            display: inline-block;
            min-width: 22px;
            padding: 0 7px;
            margin-left: 6px;
            border-radius: 999px;
            background: #eef3f9;
            color: #44546b;
            font-size: 12px;
            line-height: 20px;
        }

        .tab-btn.active .cnt {
            background: rgba(255,255,255,.22);
            color: #fff;
        }

        .tab-btn.need .cnt {
            background: #fff3d6;
            color: #8a5a00;
        }

        .tab-btn.need.active .cnt {
            background: rgba(255,255,255,.22);
            color: #fff;
        }

    /* ===== Khung danh sách ===== */
    .appt-panel {
        background: #fff;
        border: 1px solid var(--ap-line);
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 6px 22px rgba(23,40,75,.04);
    }

    .panel-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 8px;
        background: var(--ap-bar);
        color: #fff;
        padding: 14px 22px;
    }

        .panel-bar .ttl {
            font-weight: 700;
            font-size: 14px;
            letter-spacing: .6px;
            text-transform: uppercase;
        }

        .panel-bar .meta {
            font-size: 13px;
            opacity: .9;
        }

    .appt-table {
        width: 100%;
        min-width: 980px;
        border-collapse: collapse;
        margin: 0;
    }

        .appt-table thead th {
            background: var(--ap-head);
            color: #44546b;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .5px;
            text-transform: uppercase;
            padding: 12px 18px;
            border: 0;
            white-space: nowrap;
        }

        .appt-table tbody td {
            padding: 15px 18px;
            vertical-align: middle;
            border-top: 1px solid #eef2f6;
            font-size: 14px;
            color: #3c4858;
        }

        .appt-table tbody tr:hover {
            background: #f6f9fc;
        }

    .code-chip {
        display: inline-block;
        background: #eef3f9;
        color: var(--ap-navy);
        font-weight: 700;
        font-size: 12.5px;
        padding: 3px 10px;
        border-radius: 8px;
        white-space: nowrap;
    }

    .dt-date {
        font-weight: 700;
        color: var(--ap-navy);
    }

    .dt-time {
        font-size: 13px;
        color: var(--ap-muted);
        margin-top: 2px;
    }

        .dt-time i {
            margin-right: 5px;
        }

    .pt-name {
        font-weight: 700;
        color: var(--ap-navy);
        line-height: 1.25;
    }

    .pt-sub {
        font-size: 12.5px;
        color: var(--ap-muted);
    }

    .type-cell i {
        width: 18px;
        color: var(--ap-muted);
    }

    .type-sub {
        font-size: 12.5px;
        color: var(--ap-muted);
        margin-top: 3px;
    }

        .type-sub i {
            margin-right: 4px;
        }

    /* Trạng thái dạng chấm + chữ */
    .st {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13.5px;
        font-weight: 600;
        color: #44546b;
        white-space: nowrap;
    }

        .st::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #aab4c0;
        }

        .st.confirmed::before {
            background: #0056b3;
        }

        .st.done {
            color: #138a7a;
        }

            .st.done::before {
                background: #1aa38f;
            }

        .st.cancelled {
            color: #c0392b;
        }

            .st.cancelled::before {
                background: #c0392b;
            }

    .act-cell {
        text-align: right;
        white-space: nowrap;
    }

        .act-cell .btn {
            font-size: 13px;
            font-weight: 600;
            border-radius: 8px;
            padding: 5px 13px;
            margin-left: 4px;
        }
</style>

<div class="container my-4 ap-font" style="min-height: 55vh;">
    <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
        <div>
            <h3 class="font-weight-bold mb-1" style="color:var(--ap-navy)">Tổng số ca khám: @cAll</h3>
            <p class="text-muted mb-0 small">Toàn bộ ca khám của bạn, phân loại theo trạng thái. Xác nhận hoặc từ chối ca chờ ngay tại đây.</p>
        </div>
        <input type="search" id="q" class="form-control form-control-sm search-box mt-3 mt-md-0" placeholder="Tìm tên, SĐT, mã ca..." />
    </div>

    @if (cPending > 0)
    {
        <div class="appt-note">
            <i class="fa fa-bell"></i>
            <span>Bạn có <b>@cPending</b> ca đang chờ xác nhận.</span>
        </div>
    }

    <div class="tab-bar">
        @foreach (var t in tabs)
        {
            <button type="button" class="tab-btn @(t.Key == "pending" ? "need" : "") @(t.Key == status ? "active" : "")" data-tab="@t.Key">@t.Label<span class="cnt">@t.Count</span></button>
        }
    </div>

    <div class="appt-panel">
        <div class="panel-bar">
            <span class="ttl">Danh sách ca khám</span>
            <span class="meta">Hiển thị <b id="visibleCount">@cAll</b> / @cAll ca</span>
        </div>
        <div class="table-responsive">
            <table class="appt-table all-table">
                <thead>
                    <tr>
                        <th>Mã ca</th>
                        <th>Ngày giờ</th>
                        <th>Bệnh nhân</th>
                        <th>Hình thức</th>
                        <th>Trạng thái</th>
                        <th>Thanh toán</th>
                        <th style="text-align:right">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        var st = r.IsCancelled ? "cancelled" : r.IsCompleted ? "completed" : r.IsConfirmed ? "confirmed" : "pending";
                        var stClass = r.IsCancelled ? "cancelled" : r.IsCompleted ? "done" : r.IsConfirmed ? "confirmed" : "pending";
                        var stText = r.IsCancelled ? "Đã hủy" : r.IsCompleted ? "Đã khám xong" : r.IsConfirmed ? "Đã xác nhận" : "Chờ xác nhận";

                        <tr class="case-row" data-status="@st" data-search="@((r.PatientName + " " + r.PatientPhone + " " + r.Code).ToLowerInvariant())">
                            <td><span class="code-chip">@r.Code</span></td>
                            <td>
                                <div class="dt-date">@r.Date.ToString("dd/MM/yyyy")</div>
                                <div class="dt-time"><i class="fa fa-clock-o"></i>@r.TimeText</div>
                            </td>
                            <td>
                                <div class="pt-name">@r.PatientName</div>
                                <div class="pt-sub"><i class="fa fa-phone"></i> @r.PatientPhone</div>
                            </td>
                            <td>
                                @if (r.BookingType == "Online")
                                {
                                    <span class="type-cell"><i class="fa fa-video-camera"></i>Trực tuyến</span>
                                }
                                else if (r.BookingType == "Cấp cứu")
                                {
                                    <span class="type-cell"><i class="fa fa-ambulance"></i>Cấp cứu@(string.IsNullOrEmpty(r.TriageLevel) ? "" : " - mức " + r.TriageLevel)</span>
                                }
                                else
                                {
                                    <span class="type-cell"><i class="fa fa-hospital-o"></i>Tại viện</span>
                                }
                                @if (r.FileCount > 0)
                                {
                                    <div class="type-sub"><i class="fa fa-paperclip"></i>@r.FileCount tệp đính kèm</div>
                                }
                            </td>
                            <td><span class="st @stClass">@stText</span></td>
                            <td>@(string.IsNullOrEmpty(r.PaymentStatus) ? "-" : r.PaymentStatus)</td>
                            <td class="act-cell">
                                @if (r.IsPending)
                                {
                                    <form asp-action="Confirm" asp-route-id="@r.AppointId" method="post" class="d-inline">
                                        <input type="hidden" name="back" value="all" />
                                        <button type="submit" class="btn btn-sm btn-primary">Xác nhận</button>
                                    </form>
                                }
                                @if (r.IsConfirmed)
                                {
                                    if (r.BookingType == "Online")
                                    {
                                        <a asp-action="Room" asp-route-id="@r.AppointId" class="btn btn-sm btn-outline-primary"><i class="fa fa-video-camera"></i> Vào phòng</a>
                                    }
                                    <a asp-controller="Consultations" asp-action="Exam" asp-route-id="@r.AppointId" class="btn btn-sm btn-primary">Khám bệnh</a>
                                }
                                @if (r.IsCompleted)
                                {
                                    <a asp-controller="Consultations" asp-action="Exam" asp-route-id="@r.AppointId" class="btn btn-sm btn-outline-secondary">Xem bệnh án</a>
                                }
                                <a asp-action="Details" asp-route-id="@r.AppointId" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                                @if (r.IsPending || r.IsConfirmed)
                                {
                                    <form asp-action="Reject" asp-route-id="@r.AppointId" method="post" class="d-inline" onsubmit="return confirm('Hủy ca khám @r.Code của @r.PatientName?');">
                                        <input type="hidden" name="back" value="all" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Hủy</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    <tr id="emptyRow" style="display:none">
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="fa fa-inbox" style="font-size:34px"></i>
                            <div class="mt-2">Không có ca khám nào trong mục này.</div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var current = '@status';
            var tabs = document.querySelectorAll('.tab-btn');
            var rows = document.querySelectorAll('.case-row');
            var q = document.getElementById('q');
            var empty = document.getElementById('emptyRow');
            var counter = document.getElementById('visibleCount');

            function apply() {
                var term = (q.value || '').trim().toLowerCase(), shown = 0;
                rows.forEach(function(r) {
                    var ok = (current === 'all' || r.dataset.status === current) && (!term || r.dataset.search.indexOf(term) >= 0);
                    r.style.display = ok ? '' : 'none';
                    if (ok) shown++;
                });
                empty.style.display = shown === 0 ? '' : 'none';
                if (counter) counter.textContent = shown;
                tabs.forEach(function(t) { t.classList.toggle('active', t.dataset.tab === current); });
            }
            tabs.forEach(function(t) { t.addEventListener('click', function() { current = t.dataset.tab; apply(); }); });
            q.addEventListener('input', apply);
            apply();
        })();
    </script>
}
