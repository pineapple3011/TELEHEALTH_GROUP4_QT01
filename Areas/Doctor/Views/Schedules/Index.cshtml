@model SchedulePageVm
@{
    ViewData["Title"] = "Lịch trực & trạng thái";
    var days = new[] { "Chủ nhật", "Thứ hai", "Thứ ba", "Thứ tư", "Thứ năm", "Thứ sáu", "Thứ bảy" };
    var doc = Model.Doctor;
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var weekLater = DateTime.Today.AddDays(6).ToString("yyyy-MM-dd");
}

<style>
    .chip-group { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { margin: 0; cursor: pointer; }
    .chip input { position: absolute; opacity: 0; pointer-events: none; }
    .chip span { display: inline-block; padding: 7px 14px; border: 1px solid #ced4da; border-radius: 999px; background: #fff; font-size: 14px; font-weight: 600; color: #495057; transition: all .15s; user-select: none; }
    .chip:hover span { border-color: #007bff; }
    .chip input:checked + span { background: #007bff; border-color: #007bff; color: #fff; }
    .chip input:focus-visible + span { box-shadow: 0 0 0 3px rgba(0,123,255,.3); }
    .chip small { display: block; font-weight: 400; font-size: 12px; opacity: .85; }
    .slot-chip span { border-radius: 10px; text-align: center; min-width: 120px; }
    .quick-link { font-size: 13px; margin-right: 10px; }
    .bulk-summary { background: #eef5ff; border: 1px solid #cfe2ff; color: #0b4a9e; border-radius: 10px; padding: 10px 14px; font-size: 14px; }
    .bulk-summary.is-empty { background: #f8f9fa; border-color: #e2e6ea; color: #6c757d; }
</style>

<div class="container my-4" style="min-height: 55vh;">
    <div class="row">
        <!-- Trạng thái làm việc -->
        <div class="col-lg-5">
            <div class="dr-card">
                <div class="dr-card-title"><i class="fa fa-toggle-on"></i> Trạng thái làm việc</div>
                <div class="d-flex align-items-center mb-3">
                    <span class="badge @(doc.IsAvailable ? "badge-soft-turquoise" : "badge-soft-warning") px-3 py-2 rounded-pill mr-3" style="font-size:14px">
                        @(doc.IsAvailable ? "Available - Sẵn sàng" : "Busy - Đang bận")
                    </span>
                </div>
                <p class="text-muted small mb-3">
                    @(doc.IsAvailable
                        ? "Bệnh nhân đang thấy bạn ở trạng thái sẵn sàng và có thể đặt lịch. Chuyển sang Bận khi bạn tạm ngưng nhận ca."
                        : "Bệnh nhân đang thấy bạn ở trạng thái bận. Bật lại Sẵn sàng khi bạn tiếp tục nhận ca.")
                </p>
                <form asp-action="SetStatus" method="post">
                    <input type="hidden" name="status" value="@(doc.IsAvailable ? "Busy" : "Available")" />
                    <button type="submit" class="btn @(doc.IsAvailable ? "btn-outline-primary" : "btn-success") font-weight-bold">
                        <i class="fa @(doc.IsAvailable ? "fa-pause-circle" : "fa-play-circle")"></i>
                        @(doc.IsAvailable ? "Chuyển sang Bận" : "Chuyển sang Sẵn sàng")
                    </button>
                </form>
            </div>

            <div class="dr-card">
                <div class="dr-card-title"><i class="fa fa-plus-circle"></i> Thêm ca trực nhanh</div>
                <form asp-action="CreateBulk" method="post" id="bulkForm">
                    <!-- 1. Khoảng ngày -->
                    <label class="small font-weight-bold mb-1">1. Khoảng ngày</label>
                    <div class="form-row">
                        <div class="form-group col-6 mb-2">
                            <input id="bFrom" type="date" name="Bulk.FromDate" class="form-control" min="@today" value="@today" required />
                        </div>
                        <div class="form-group col-6 mb-2">
                            <input id="bTo" type="date" name="Bulk.ToDate" class="form-control" min="@today" value="@weekLater" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <a href="#" class="quick-link" data-range="7">7 ngày tới</a>
                        <a href="#" class="quick-link" data-range="14">2 tuần tới</a>
                        <a href="#" class="quick-link" data-range="30">30 ngày tới</a>
                        <a href="#" class="quick-link" data-range="month">Hết tháng này</a>
                    </div>

                    <!-- 2. Các thứ trong tuần -->
                    <label class="small font-weight-bold mb-1">2. Trực vào các thứ</label>
                    <div class="chip-group mb-1">
                        @foreach (var d in new[] { (1, "T2"), (2, "T3"), (3, "T4"), (4, "T5"), (5, "T6"), (6, "T7"), (0, "CN") })
                        {
                            <label class="chip"><input type="checkbox" name="Bulk.Days" value="@d.Item1" class="day-cb" @(d.Item1 >= 1 && d.Item1 <= 5 ? "checked" : "") /><span>@d.Item2</span></label>
                        }
                    </div>
                    <div class="mb-3">
                        <a href="#" class="quick-link" data-days="1,2,3,4,5">Thứ 2 - Thứ 6</a>
                        <a href="#" class="quick-link" data-days="0,1,2,3,4,5,6">Cả tuần</a>
                        <a href="#" class="quick-link" data-days="6,0">Cuối tuần</a>
                    </div>

                    <!-- 3. Khung giờ -->
                    <label class="small font-weight-bold mb-1">3. Khung giờ (chọn một hoặc nhiều)</label>
                    <div class="chip-group mb-2">
                        <label class="chip slot-chip"><input type="checkbox" name="Bulk.Slots" value="08:00-12:00" class="slot-cb" checked /><span>Sáng<small>08:00 - 12:00</small></span></label>
                        <label class="chip slot-chip"><input type="checkbox" name="Bulk.Slots" value="13:30-17:30" class="slot-cb" /><span>Chiều<small>13:30 - 17:30</small></span></label>
                        <label class="chip slot-chip"><input type="checkbox" name="Bulk.Slots" value="18:00-21:00" class="slot-cb" /><span>Tối<small>18:00 - 21:00</small></span></label>
                    </div>
                    <div class="form-row align-items-end mb-3">
                        <div class="col-12"><span class="small text-muted">Hoặc tự đặt khung giờ riêng:</span></div>
                        <div class="form-group col-6 mb-0">
                            <input id="cStart" type="time" name="Bulk.CustomStart" class="form-control form-control-sm" />
                        </div>
                        <div class="form-group col-6 mb-0">
                            <input id="cEnd" type="time" name="Bulk.CustomEnd" class="form-control form-control-sm" />
                        </div>
                    </div>

                    <div id="bulkSummary" class="bulk-summary mb-3"></div>
                    <button type="submit" class="btn btn-primary font-weight-bold" id="bulkSubmit"><i class="fa fa-save"></i> Tạo lịch trực</button>
                </form>
            </div>
        </div>

        <!-- Danh sách lịch trực -->
        <div class="col-lg-7">
            <div class="dr-card">
                <div class="dr-card-title"><i class="fa fa-calendar"></i> Lịch trực sắp tới (@Model.Upcoming.Count ca)</div>
                @if (!Model.Upcoming.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="fa fa-calendar-o" style="font-size:44px"></i>
                        <p class="mt-2 mb-0">Bạn chưa có ca trực nào sắp tới. Thêm ca trực để bệnh nhân chọn được khung giờ khám.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="thead-light">
                                <tr><th>Ngày</th><th>Khung giờ</th><th>Ca đã đặt</th><th></th></tr>
                            </thead>
                            <tbody>
                            @foreach (var s in Model.Upcoming)
                            {
                                <tr>
                                    <td>
                                        <b>@s.WorkDate.ToString("dd/MM/yyyy")</b>
                                        <div class="small text-muted">@days[(int)s.WorkDate.DayOfWeek]</div>
                                    </td>
                                    <td><span class="font-weight-bold text-success">@DateTime.Today.Add(s.StartTime).ToString("HH:mm") - @DateTime.Today.Add(s.EndTime).ToString("HH:mm")</span></td>
                                    <td>
                                        @if (s.ActiveAppointments > 0)
                                        {
                                            <a asp-controller="Appointments" asp-action="Index" asp-route-date="@s.WorkDate.ToString("yyyy-MM-dd")" class="badge badge-soft-info px-3 py-1 rounded-pill">@s.ActiveAppointments ca</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Chưa có</span>
                                        }
                                    </td>
                                    <td class="text-right">
                                        @if (s.ActiveAppointments == 0)
                                        {
                                            <form asp-action="Delete" asp-route-id="@s.ScheduleId" method="post" class="d-inline" onsubmit="return confirm('Xóa ca trực này?');">
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small" title="Đang có bệnh nhân đặt lịch">Đang có ca</span>
                                        }
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var from = document.getElementById('bFrom'), to = document.getElementById('bTo');
    var cStart = document.getElementById('cStart'), cEnd = document.getElementById('cEnd');
    var summary = document.getElementById('bulkSummary'), submit = document.getElementById('bulkSubmit');
    var dayNames = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];

    function fmt(d) {
        var m = d.getMonth() + 1, day = d.getDate();
        return d.getFullYear() + '-' + (m < 10 ? '0' : '') + m + '-' + (day < 10 ? '0' : '') + day;
    }
    function parse(v) { var p = v.split('-'); return new Date(+p[0], +p[1] - 1, +p[2]); }

    function update() {
        if (from.value) to.min = from.value;   // luôn đồng bộ giới hạn ngày kết thúc, kể cả khi đổi ngày bằng nút nhanh
        var days = [].slice.call(document.querySelectorAll('.day-cb:checked')).map(function (x) { return +x.value; });
        var slots = document.querySelectorAll('.slot-cb:checked').length + ((cStart.value && cEnd.value) ? 1 : 0);
        var ok = from.value && to.value && parse(to.value) >= parse(from.value);
        var count = 0, dayCount = 0;
        if (ok) {
            for (var d = parse(from.value), end = parse(to.value); d <= end; d.setDate(d.getDate() + 1)) {
                if (days.indexOf(d.getDay()) >= 0) dayCount++;
            }
            count = dayCount * slots;
        }
        var bad = !ok || !days.length || !slots || count === 0;
        summary.className = 'bulk-summary mb-3' + (bad ? ' is-empty' : '');
        if (!ok) summary.textContent = 'Ngày kết thúc phải sau hoặc bằng ngày bắt đầu.';
        else if (!days.length) summary.textContent = 'Chọn ít nhất một ngày trong tuần.';
        else if (!slots) summary.textContent = 'Chọn ít nhất một khung giờ.';
        else if (count === 0) summary.textContent = 'Không có ngày nào khớp trong khoảng đã chọn.';
        else summary.innerHTML = 'Sẽ tạo tối đa <b>' + count + ' ca</b> (' + dayCount + ' ngày × ' + slots + ' khung giờ). Ca trùng giờ hoặc đã qua sẽ tự bỏ qua.';
        submit.disabled = bad;
    }

    document.querySelectorAll('#bulkForm input').forEach(function (i) { i.addEventListener('change', update); i.addEventListener('input', update); });

    document.querySelectorAll('[data-range]').forEach(function (a) {
        a.addEventListener('click', function (e) {
            e.preventDefault();
            var t = new Date(), end = new Date();
            if (a.dataset.range === 'month') end = new Date(t.getFullYear(), t.getMonth() + 1, 0);
            else end.setDate(t.getDate() + (+a.dataset.range - 1));
            from.value = fmt(t); to.value = fmt(end); update();
        });
    });

    document.querySelectorAll('[data-days]').forEach(function (a) {
        a.addEventListener('click', function (e) {
            e.preventDefault();
            var set = a.dataset.days.split(',');
            document.querySelectorAll('.day-cb').forEach(function (cb) { cb.checked = set.indexOf(cb.value) >= 0; });
            update();
        });
    });

    from.addEventListener('change', function () { if (from.value && to.value < from.value) to.value = from.value; update(); });
    update();
})();
</script>
}
