                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="single-footer-widget">
                            <div class="widget-title"><h5>TRUNG TÂM Y TẾ</h5></div>
                            <div class="contact-information">
                                <p><span>Cơ sở chính:</span> 2 Cầu Giấy, Quận Cầu Giấy, Hà Nội</p>
                                <p><span>Hỗ trợ bác sĩ:</span> hotline@telehealth.vn / 1900 1234</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom-area">
            <div class="container">
                <div class="row">
                    <div class="col-12"><div class="border-line"></div></div>
                    <div class="col-12 col-md-6">
                        <div class="copywrite-text">
                            <p>Copyright &copy; @DateTime.Now.Year All rights reserved | TELEHEALTH GROUP 4 - Phân hệ Bác sĩ.</p>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="footer-nav">
                            <nav>
                                <ul>
                                    @if (doc != null)
                                    {
                                    <li><a asp-area="Doctor" asp-controller="Appointments" asp-action="Index">Ca khám</a></li>
                                    <li><a asp-area="Doctor" asp-controller="Schedules" asp-action="Index">Lịch trực</a></li>
                                    <li><a asp-area="Doctor" asp-controller="Profile" asp-action="Index">Hồ sơ</a></li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>
    }

    <script src="~/js/jquery/jquery-2.2.4.min.js"></script>
    <script src="~/js/bootstrap/popper.min.js"></script>
    <script src="~/js/bootstrap/bootstrap.min.js"></script>
    <script src="~/js/plugins/plugins.js"></script>
    <script src="~/js/active.js"></script>
    <script src="~/js/ajax-nav.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
