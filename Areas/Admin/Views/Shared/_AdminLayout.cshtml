@{
    var ctrl = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var act = (ViewContext.RouteData.Values["action"] as string) ?? "";

    bool On(string c, string? a = null) =>
        string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) &&
        (a == null || string.Equals(act, a, StringComparison.OrdinalIgnoreCase));

    // Tab Bệnh nhân / Bác sĩ cùng thuộc Accounts nên so theo tên action
    var onPatients = On("Accounts") && (act.EndsWith("Patient", StringComparison.OrdinalIgnoreCase) || act.Equals("Patients", StringComparison.OrdinalIgnoreCase));
    var onDoctors = On("Accounts") && !onPatients;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - TELEHEALTH Admin</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="admin">
    <div class="ad-shell">
        <aside class="ad-side">
            <div class="ad-brand">
                <b>TELEHEALTH</b>
                <span>Quản trị hệ thống</span>
            </div>

            <!-- Chuyển ngôn ngữ VI | EN (kế thừa màu chữ của sidebar; nếu sidebar nền tối mà chữ khó đọc, đổi "light" thành "dark") -->
            <div class="px-3 pb-2" style="margin-top:-4px">
                <!-- ===== Nút dịch VI | EN (Google Translate) ===== -->
<span class="th-lang notranslate" translate="no">
    <a href="#" data-lang="vi">VI</a> <span class="th-sep">|</span> <a href="#" data-lang="en">EN</a>
</span>
<div id="google_translate_element" style="display:none"></div>
<style>
    .th-lang { display: inline-flex; align-items: center; gap: 8px; margin-right: 18px; font-size: 13px; font-weight: 600; line-height: 1; vertical-align: middle; }
    .th-lang a { color: inherit !important; text-decoration: none; opacity: .6; }
    .th-lang a:hover, .th-lang a.active { opacity: 1; }
    .th-lang a.active { text-decoration: underline; text-underline-offset: 4px; }
    .th-lang .th-sep { opacity: .4; }
    .goog-te-banner-frame, .goog-te-banner-frame.skiptranslate, body > .skiptranslate, #goog-gt-tt, .goog-tooltip { display: none !important; }
    body { top: 0 !important; }
    .goog-text-highlight { background: none !important; box-shadow: none !important; }
</style>
<script>
    (function () {
        var m = document.cookie.match(/(?:^|; )googtrans=([^;]*)/);
        var cur = (m && decodeURIComponent(m[1]).split('/')[2] === 'en') ? 'en' : 'vi';

        function setLang(c) {
            var past = 'googtrans=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/', h = location.hostname;
            document.cookie = past; document.cookie = past + '; domain=' + h; document.cookie = past + '; domain=.' + h;
            if (c === 'en') document.cookie = 'googtrans=/vi/en; path=/';
            location.reload();
        }
        document.querySelectorAll('.th-lang a').forEach(function (a) {
            var c = a.getAttribute('data-lang');
            if (c === cur) a.classList.add('active');
            a.addEventListener('click', function (e) {
                e.preventDefault(); e.stopPropagation();   // tránh ajax-nav.js chặn click
                if (c !== cur) setLang(c);
            });
        });

        if (cur === 'en') {   // chỉ tải Google khi đang xem bản tiếng Anh
            window.googleTranslateElementInit = function () {
                new google.translate.TranslateElement({ pageLanguage: 'vi', includedLanguages: 'en', autoDisplay: false }, 'google_translate_element');
            };
            var s = document.createElement('script');
            s.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
            document.head.appendChild(s);
        }
    })();
</script>
<!-- ===== Hết nút dịch ===== -->
            </div>

            <nav>
                <a class="ad-link @(On("Dashboard") ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Tổng quan</a>

                <div class="ad-group">Tài khoản</div>
                <a class="ad-link @(onPatients ? "active" : "")" asp-area="Admin" asp-controller="Accounts" asp-action="Patients">Bệnh nhân</a>
                <a class="ad-link @(onDoctors ? "active" : "")" asp-area="Admin" asp-controller="Accounts" asp-action="Doctors">Bác sĩ</a>

                <div class="ad-group">Theo dõi và báo cáo</div>
                <a class="ad-link @(On("Monitoring") ? "active" : "")" asp-area="Admin" asp-controller="Monitoring" asp-action="Index">Bệnh nhân, hồ sơ, bác sĩ</a>
                <a class="ad-link @(On("Revenue") ? "active" : "")" asp-area="Admin" asp-controller="Revenue" asp-action="Index">Doanh thu</a>

                <div class="ad-group">Danh mục</div>
                <a class="ad-link @(On("Specialties") ? "active" : "")" asp-area="Admin" asp-controller="Specialties" asp-action="Index">Chuyên khoa và giá</a>
                <a class="ad-link @(On("Clinics") ? "active" : "")" asp-area="Admin" asp-controller="Clinics" asp-action="Index">Phòng khám</a>

                <div class="ad-back">
                    <a class="ad-link" asp-area="" asp-controller="Home" asp-action="Index">Về trang bệnh nhân</a>
                </div>
            </nav>
        </aside>

        <main class="ad-main">
            @if (TempData["Msg"] != null)
            {
                <div class="ad-alert ok" role="status">@TempData["Msg"]</div>
            }
            @if (TempData["Err"] != null)
            {
                <div class="ad-alert bad" role="alert">@TempData["Err"]</div>
            }
            @RenderBody()
        </main>
    </div>

    <script>
        // Xác nhận trước khi thực hiện thao tác nguy hiểm: <form data-confirm="...">
        document.addEventListener('submit', function (e) {
            var m = e.target.getAttribute && e.target.getAttribute('data-confirm');
            if (m && !window.confirm(m)) e.preventDefault();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
